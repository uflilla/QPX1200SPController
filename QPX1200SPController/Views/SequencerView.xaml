<UserControl
  x:Class="QPX1200SPController.Views.SequencerView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
  d:DesignHeight="600"
  d:DesignWidth="1100"
  DataContext="{Binding Sequencer, Source={StaticResource Locator}}"
  mc:Ignorable="d">
  <UserControl.Resources>
    <Style
      x:Key="ToolButton"
      BasedOn="{StaticResource MaterialDesignOutlinedButton}"
      TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Resources>

  <Grid Margin="10">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="10" />
      <ColumnDefinition Width="330" />
    </Grid.ColumnDefinitions>

    <!--  Steps  -->
    <materialDesign:Card Padding="10" materialDesign:ElevationAssist.Elevation="Dp1">
      <DockPanel>
        <StackPanel
          Margin="0,0,0,8"
          DockPanel.Dock="Top"
          Orientation="Horizontal">
          <Button
            AutomationProperties.Name="Add step"
            Command="{Binding AddCommand}"
            Style="{StaticResource ToolButton}"
            ToolTip="Add a step after the selected one">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Margin="0,0,4,0" Kind="PlaylistPlus" />
              <TextBlock Text="ADD" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="Remove step"
            Command="{Binding RemoveCommand}"
            Style="{StaticResource ToolButton}"
            ToolTip="Remove the selected step">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Margin="0,0,4,0" Kind="PlaylistRemove" />
              <TextBlock Text="REMOVE" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="Move up"
            Command="{Binding MoveUpCommand}"
            Style="{StaticResource ToolButton}"
            ToolTip="Move up">
            <materialDesign:PackIcon Kind="ArrowUp" />
          </Button>
          <Button
            AutomationProperties.Name="Move down"
            Command="{Binding MoveDownCommand}"
            Style="{StaticResource ToolButton}"
            ToolTip="Move down">
            <materialDesign:PackIcon Kind="ArrowDown" />
          </Button>
          <Rectangle
            Width="1"
            Margin="6,4,12,4"
            Fill="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
          <Button
            AutomationProperties.Name="Open sequence"
            Command="{Binding LoadFileCommand}"
            Style="{StaticResource ToolButton}"
            ToolTip="Load steps from a CSV file (Voltage,Current,DurationSeconds,Ramp)">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Margin="0,0,4,0" Kind="FolderOpenOutline" />
              <TextBlock Text="OPEN" />
            </StackPanel>
          </Button>
          <Button
            AutomationProperties.Name="Save sequence"
            Command="{Binding SaveFileCommand}"
            Style="{StaticResource ToolButton}"
            ToolTip="Save the steps to a CSV file">
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Margin="0,0,4,0" Kind="ContentSaveOutline" />
              <TextBlock Text="SAVE" />
            </StackPanel>
          </Button>
        </StackPanel>

        <TextBlock
          Margin="2,8,0,0"
          DockPanel.Dock="Bottom"
          FontSize="12"
          Opacity="0.7"
          Text="Ramp: the voltage moves linearly from the previous value to the step's value over the step (one command per second). Without ramp the step jumps to its values at the start."
          TextWrapping="Wrap" />

        <DataGrid
          AutoGenerateColumns="False"
          AutomationProperties.Name="Sequence steps"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          CanUserReorderColumns="False"
          CanUserSortColumns="False"
          IsReadOnly="{Binding IsRunning}"
          ItemsSource="{Binding Steps}"
          SelectedItem="{Binding SelectedStep}"
          SelectionMode="Single"
          Style="{StaticResource MaterialDesignDataGrid}">
          <DataGrid.RowStyle>
            <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                  <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.Primary}" />
                  <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Primary.Foreground}" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DataGrid.RowStyle>
          <DataGrid.Columns>
            <DataGridTextColumn
              Width="50"
              Binding="{Binding Number}"
              Header="#"
              IsReadOnly="True" />
            <DataGridTextColumn
              Width="110"
              Binding="{Binding StartsAtText}"
              Header="Starts at"
              IsReadOnly="True" />
            <DataGridTextColumn
              Width="120"
              Binding="{Binding Voltage, StringFormat='{}{0:0.000}', ConverterCulture=en-US}"
              Header="Voltage (V)" />
            <DataGridTextColumn
              Width="120"
              Binding="{Binding Current, StringFormat='{}{0:0.000}', ConverterCulture=en-US}"
              Header="Current (A)" />
            <DataGridTextColumn
              Width="130"
              Binding="{Binding DurationSeconds, StringFormat='{}{0:0.###}', ConverterCulture=en-US}"
              Header="Duration (s)" />
            <DataGridCheckBoxColumn
              Width="80"
              Binding="{Binding Ramp, UpdateSourceTrigger=PropertyChanged}"
              Header="Ramp" />
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>
    </materialDesign:Card>

    <!--  Run  -->
    <materialDesign:Card
      Grid.Column="2"
      Padding="16,12"
      materialDesign:ElevationAssist.Elevation="Dp1">
      <StackPanel>
        <TextBlock
          FontSize="15"
          FontWeight="SemiBold"
          Text="Run" />
        <TextBlock
          Margin="0,4,0,12"
          FontSize="12"
          Opacity="0.75"
          Text="{Binding TotalDurationText}"
          TextWrapping="Wrap" />

        <DockPanel Margin="0,0,0,8">
          <xctk:IntegerUpDown
            Width="90"
            Height="28"
            AutomationProperties.Name="Cycles"
            DockPanel.Dock="Right"
            IsEnabled="{Binding IsEditable}"
            Maximum="100000"
            Minimum="1"
            Value="{Binding Cycles}" />
          <TextBlock VerticalAlignment="Center" Text="Cycles (repeat the steps)" />
        </DockPanel>
        <CheckBox
          Margin="0,4,0,0"
          Content="Switch the output ON at the start"
          IsChecked="{Binding OutputOnAtStart}"
          IsEnabled="{Binding IsEditable}" />
        <CheckBox
          Margin="0,4,0,0"
          Content="Switch the output OFF at the end or on stop"
          IsChecked="{Binding OutputOffAtEnd}"
          IsEnabled="{Binding IsEditable}" />

        <UniformGrid Margin="0,16,0,0" Columns="3">
          <Button
            Height="36"
            Margin="0,0,4,0"
            AutomationProperties.Name="Start sequence"
            Command="{Binding StartCommand}"
            Content="START"
            Style="{StaticResource MaterialDesignRaisedButton}"
            ToolTip="Connect to the supply first" />
          <Button
            Height="36"
            Margin="2,0"
            AutomationProperties.Name="Pause sequence"
            Command="{Binding PauseCommand}"
            Content="{Binding PauseButtonText}"
            Style="{StaticResource MaterialDesignOutlinedButton}"
            ToolTip="Hold the present set-points; the step time stops too" />
          <Button
            Height="36"
            Margin="4,0,0,0"
            AutomationProperties.Name="Stop sequence"
            Background="#C62828"
            BorderBrush="#C62828"
            Command="{Binding StopCommand}"
            Content="STOP"
            Foreground="White"
            Style="{StaticResource MaterialDesignRaisedButton}" />
        </UniformGrid>

        <ProgressBar
          Height="8"
          Margin="0,16,0,6"
          materialDesign:TransitionAssist.DisableTransitions="True"
          Maximum="100"
          Value="{Binding Progress, Mode=OneWay}" />
        <TextBlock
          Text="{Binding StatusText}"
          TextWrapping="Wrap" />

        <Border
          Margin="0,16,0,0"
          Padding="10,8"
          BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
          BorderThickness="1"
          CornerRadius="6">
          <TextBlock
            FontSize="11"
            Opacity="0.8"
            TextWrapping="Wrap">
            Steps must stay inside the soft limits and below the OVP level. The run stops if a command fails, the link is lost, or the output is switched off (by you, an alarm or a trip). Manual set-point commands are disabled while it runs; TURN OUTPUT OFF always works.
          </TextBlock>
        </Border>
      </StackPanel>
    </materialDesign:Card>
  </Grid>
</UserControl>
