<UserControl
  x:Class="QPX1200SPController.Views.Settings"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="450"
  d:DesignWidth="800"
  DataContext="{Binding Settings, Source={StaticResource Locator}}"
  mc:Ignorable="d">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <materialDesign:Card
      MinWidth="520"
      MaxWidth="720"
      Margin="24"
      Padding="24"
      HorizontalAlignment="Center"
      materialDesign:ElevationAssist.Elevation="Dp2">
      <StackPanel>
        <StackPanel
          Margin="0,0,0,20"
          HorizontalAlignment="Center"
          Orientation="Horizontal">
          <materialDesign:PackIcon
            Width="28"
            Height="28"
            VerticalAlignment="Center"
            Kind="CogOutline" />
          <TextBlock
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            Style="{StaticResource MaterialDesignHeadline5TextBlock}"
            Text="Settings" />
        </StackPanel>

        <materialDesign:Card
          Margin="0,0,0,14"
          Padding="16"
          UniformCornerRadius="8">
          <StackPanel>
            <TextBlock
              Margin="0,0,0,12"
              Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
              Text="Voltage Limits" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox
                materialDesign:HintAssist.Hint="Min Voltage"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                Text="{Binding MinVoltage, StringFormat={}{0:F2}}" />
              <TextBox
                Grid.Column="2"
                materialDesign:HintAssist.Hint="Max Voltage"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                Text="{Binding MaxVoltage, StringFormat={}{0:F2}}" />
            </Grid>
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card
          Margin="0,0,0,14"
          Padding="16"
          UniformCornerRadius="8">
          <StackPanel>
            <TextBlock
              Margin="0,0,0,12"
              Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
              Text="Current Limits" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBox
                materialDesign:HintAssist.Hint="Min Current"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                Text="{Binding MinCurrent, StringFormat={}{0:F2}}" />
              <TextBox
                Grid.Column="2"
                materialDesign:HintAssist.Hint="Max Current"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                Text="{Binding MaxCurrent, StringFormat={}{0:F2}}" />
            </Grid>
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card
          Margin="0,0,0,20"
          Padding="16"
          UniformCornerRadius="8">
          <StackPanel>
            <TextBlock
              Margin="0,0,0,12"
              Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
              Text="Protection Limits" />
            <TextBlock Margin="0,0,0,8" Opacity="0.8">
              <Run FontWeight="SemiBold" Text="OVP Range (V): " />
              <Run Text="{Binding MinOvpLevel, Mode=OneWay, StringFormat='{}{0:F2}'}" />
              <Run Text=" – " />
              <Run Text="{Binding MaxOvpLevel, Mode=OneWay, StringFormat='{}{0:F2}'}" />
            </TextBlock>
            <TextBlock Opacity="0.8">
              <Run FontWeight="SemiBold" Text="OCP Range (A): " />
              <Run Text="{Binding MinOcpLevel, Mode=OneWay, StringFormat='{}{0:F2}'}" />
              <Run Text=" – " />
              <Run Text="{Binding MaxOcpLevel, Mode=OneWay, StringFormat='{}{0:F2}'}" />
            </TextBlock>
          </StackPanel>
        </materialDesign:Card>

        <Button
          HorizontalAlignment="Right"
          Command="{Binding SaveCommand}"
          Content="SAVE SETTINGS"
          Style="{StaticResource MaterialDesignRaisedButton}" />
      </StackPanel>
    </materialDesign:Card>
  </ScrollViewer>
</UserControl>
