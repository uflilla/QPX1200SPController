<UserControl
  x:Class="QPX1200SPController.Views.MeterTile"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  x:Name="Root">
  <Border
    Padding="14,10,14,8"
    BorderThickness="1"
    CornerRadius="10">
    <Border.BorderBrush>
      <SolidColorBrush Opacity="0.45" Color="{Binding Accent.Color, ElementName=Root}" />
    </Border.BorderBrush>
    <Border.Background>
      <SolidColorBrush Opacity="0.08" Color="{Binding Accent.Color, ElementName=Root}" />
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel Orientation="Horizontal">
        <materialDesign:PackIcon
          Width="18"
          Height="18"
          VerticalAlignment="Center"
          Foreground="{Binding Accent, ElementName=Root}"
          Kind="{Binding Icon, ElementName=Root}" />
        <TextBlock
          Margin="6,0,0,0"
          VerticalAlignment="Center"
          FontSize="12"
          FontWeight="SemiBold"
          Foreground="{Binding Accent, ElementName=Root}"
          Text="{Binding Label, ElementName=Root}" />
      </StackPanel>

      <Viewbox
        Grid.Row="1"
        Margin="0,2"
        HorizontalAlignment="Center"
        Stretch="Uniform"
        StretchDirection="Both">
        <StackPanel Orientation="Horizontal">
          <!--
            Tabular (fixed-width) digits, and the width of SizingText reserved by an invisible copy:
            the read-out keeps one size whatever the value (12.500 and 0.624 alike).
          -->
          <Grid Typography.NumeralAlignment="Tabular">
            <TextBlock
              FontFamily="Bahnschrift, Segoe UI"
              FontSize="120"
              FontWeight="SemiBold"
              Text="{Binding SizingText, ElementName=Root}"
              Visibility="Hidden" />
            <TextBlock
              x:Name="ValueText"
              HorizontalAlignment="Right"
              FontFamily="Bahnschrift, Segoe UI"
              FontSize="120"
              FontWeight="SemiBold"
              Text="{Binding Value, ElementName=Root}" />
          </Grid>
          <TextBlock
            Margin="10,0,0,16"
            VerticalAlignment="Bottom"
            FontFamily="Bahnschrift, Segoe UI"
            FontSize="44"
            Opacity="0.7"
            Text="{Binding Unit, ElementName=Root}" />
        </StackPanel>
      </Viewbox>

      <DockPanel Grid.Row="2" Opacity="0.85">
        <TextBlock
          DockPanel.Dock="Right"
          FontSize="12"
          Text="{Binding FooterRight, ElementName=Root}" />
        <TextBlock
          FontSize="12"
          Text="{Binding FooterLeft, ElementName=Root}"
          TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Grid>
  </Border>
</UserControl>
