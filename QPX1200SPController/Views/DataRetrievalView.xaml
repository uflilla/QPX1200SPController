<UserControl
  x:Class="QPX1200SPController.Views.DataRetrievalView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
  d:DesignHeight="450"
  d:DesignWidth="800"
  DataContext="{Binding DataRetrieval, Source={StaticResource Locator}}"
  mc:Ignorable="d">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel
      Grid.Row="0"
      Margin="0,0,0,12"
      HorizontalAlignment="Center"
      Orientation="Horizontal">
      <materialDesign:PackIcon
        Width="28"
        Height="28"
        VerticalAlignment="Center"
        Kind="DatabaseSearchOutline" />
      <TextBlock
        Margin="10,0,0,0"
        VerticalAlignment="Center"
        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
        Text="Data Logs" />
    </StackPanel>

    <materialDesign:Card
      Grid.Row="1"
      Margin="0,0,0,12"
      Padding="16"
      materialDesign:ElevationAssist.Elevation="Dp2">
      <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Text="Start Date/Time" />
        <xctk:DateTimePicker
          MinWidth="220"
          Margin="0,0,16,0"
          VerticalAlignment="Center"
          Format="Custom"
          FormatString="yyyy-MM-dd HH:mm:ss"
          Value="{Binding StartDate}" />
        <TextBlock
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Text="End Date/Time" />
        <xctk:DateTimePicker
          MinWidth="220"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Format="Custom"
          FormatString="yyyy-MM-dd HH:mm:ss"
          IsEnabled="{Binding IsEndNow, Converter={StaticResource InverseBoolConverter}}"
          Value="{Binding EndDate}" />
        <CheckBox
          Margin="0,0,16,0"
          VerticalAlignment="Center"
          Content="Up to now"
          IsChecked="{Binding IsEndNow}"
          Style="{StaticResource MaterialDesignCheckBox}"
          ToolTip="Use the current time as the end of the range each time data is loaded" />
        <Button
          Margin="0,0,8,0"
          Command="{Binding LoadDataCommand}"
          Content="LOAD DATA"
          Style="{StaticResource MaterialDesignRaisedButton}" />
        <Button
          Command="{Binding ExportToCsvCommand}"
          Content="EXPORT CSV"
          Style="{StaticResource MaterialDesignOutlinedButton}" />
      </WrapPanel>
    </materialDesign:Card>

    <materialDesign:Card
      Grid.Row="2"
      materialDesign:ElevationAssist.Elevation="Dp2">
      <TabControl
        materialDesign:ColorZoneAssist.Mode="Standard"
        SelectedIndex="{Binding SelectedTabIndex}"
        Style="{StaticResource MaterialDesignTabControl}">
        <TabItem Header="Measurements">
      <DockPanel>
      <StackPanel
        Margin="8,8,8,0"
        DockPanel.Dock="Top"
        Orientation="Horizontal">
        <Button
          Height="28"
          Margin="0,0,4,0"
          Command="{Binding FirstPageCommand}"
          Style="{StaticResource MaterialDesignOutlinedButton}"
          AutomationProperties.Name="First page"
          ToolTip="First page">
          <materialDesign:PackIcon Kind="PageFirst" />
        </Button>
        <Button
          Height="28"
          Margin="0,0,4,0"
          Command="{Binding PreviousPageCommand}"
          Style="{StaticResource MaterialDesignOutlinedButton}"
          AutomationProperties.Name="Previous page"
          ToolTip="Previous page">
          <materialDesign:PackIcon Kind="ChevronLeft" />
        </Button>
        <Button
          Height="28"
          Margin="0,0,4,0"
          Command="{Binding NextPageCommand}"
          Style="{StaticResource MaterialDesignOutlinedButton}"
          AutomationProperties.Name="Next page"
          ToolTip="Next page">
          <materialDesign:PackIcon Kind="ChevronRight" />
        </Button>
        <Button
          Height="28"
          Margin="0,0,12,0"
          Command="{Binding LastPageCommand}"
          Style="{StaticResource MaterialDesignOutlinedButton}"
          AutomationProperties.Name="Last page"
          ToolTip="Last page">
          <materialDesign:PackIcon Kind="PageLast" />
        </Button>
        <TextBlock VerticalAlignment="Center" Text="{Binding PageText}" />
      </StackPanel>
      <DataGrid
        Margin="8"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        EnableRowVirtualization="True"
        EnableColumnVirtualization="True"
        IsReadOnly="True"
        ItemsSource="{Binding Logs}"
        Style="{StaticResource MaterialDesignDataGrid}"
        VirtualizingPanel.IsVirtualizing="True"
        VirtualizingPanel.VirtualizationMode="Recycling">
        <DataGrid.Columns>
          <DataGridTextColumn
            Width="180"
            Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"
            Header="Timestamp" />
          <DataGridTextColumn
            Width="100"
            Binding="{Binding Voltage, StringFormat='{}{0:F3}'}"
            Header="Voltage (V)" />
          <DataGridTextColumn
            Width="100"
            Binding="{Binding Current, StringFormat='{}{0:F3}'}"
            Header="Current (A)" />
          <DataGridTextColumn
            Width="100"
            Binding="{Binding Power, StringFormat='{}{0:F2}'}"
            Header="Power (W)" />
          <DataGridCheckBoxColumn
            Width="70"
            Binding="{Binding OutputEnabled}"
            Header="Output" />
          <DataGridCheckBoxColumn
            Width="70"
            Binding="{Binding CvMode}"
            Header="CV Mode" />
          <DataGridCheckBoxColumn
            Width="70"
            Binding="{Binding CcMode}"
            Header="CC Mode" />
          <DataGridCheckBoxColumn
            Width="120"
            Binding="{Binding UnregulatedMode}"
            Header="Unregulated" />
          <DataGridCheckBoxColumn
            Width="70"
            Binding="{Binding OvpTrip}"
            Header="OVP Trip" />
          <DataGridCheckBoxColumn
            Width="70"
            Binding="{Binding OcpTrip}"
            Header="OCP Trip" />
          <DataGridCheckBoxColumn
            Width="80"
            Binding="{Binding SenseTrip}"
            Header="Sense Trip" />
          <DataGridCheckBoxColumn
            Width="80"
            Binding="{Binding FaultTrip}"
            Header="Fault Trip" />
        </DataGrid.Columns>
      </DataGrid>
      </DockPanel>
        </TabItem>
        <TabItem Header="Commands &amp; events">
          <DataGrid
            Margin="8"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            EnableRowVirtualization="True"
            IsReadOnly="True"
            ItemsSource="{Binding Activities}"
            Style="{StaticResource MaterialDesignDataGrid}">
            <DataGrid.RowStyle>
              <Style BasedOn="{StaticResource MaterialDesignDataGridRow}" TargetType="DataGridRow">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Result}" Value="Failed">
                    <Setter Property="Foreground" Value="#C62828" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Result}" Value="Mismatch">
                    <Setter Property="Foreground" Value="#E65100" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Result}" Value="Lost">
                    <Setter Property="Foreground" Value="#E65100" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTextColumn
                Width="180"
                Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"
                Header="Timestamp" />
              <DataGridTextColumn
                Width="95"
                Binding="{Binding Kind}"
                Header="Type" />
              <DataGridTextColumn
                Width="110"
                Binding="{Binding Source}"
                Header="Source" />
              <DataGridTextColumn
                Width="170"
                Binding="{Binding Command}"
                Header="Command" />
              <DataGridTextColumn
                Width="100"
                Binding="{Binding Result}"
                Header="Result" />
              <DataGridTextColumn
                Width="90"
                Binding="{Binding Requested, StringFormat='{}{0:F3}'}"
                Header="Requested" />
              <DataGridTextColumn
                Width="90"
                Binding="{Binding Readback, StringFormat='{}{0:F3}'}"
                Header="Read-back" />
              <DataGridTextColumn
                Width="70"
                Binding="{Binding DurationMs, StringFormat='{}{0:F0}'}"
                Header="ms" />
              <DataGridTemplateColumn Width="*" Header="Detail">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </TabItem>
      </TabControl>
    </materialDesign:Card>

    <materialDesign:ColorZone
      Grid.Row="3"
      Margin="0,12,0,0"
      Padding="12,8"
      Mode="Standard">
      <DockPanel>
        <TextBlock
          VerticalAlignment="Center"
          Text="{Binding StatusMessage}" />
        <ProgressBar
          Width="120"
          Height="4"
          Margin="16,0,0,0"
          HorizontalAlignment="Right"
          DockPanel.Dock="Right"
          IsIndeterminate="{Binding IsLoading}"
          Style="{StaticResource MaterialDesignLinearProgressBar}"
          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
      </DockPanel>
    </materialDesign:ColorZone>
  </Grid>
</UserControl>
