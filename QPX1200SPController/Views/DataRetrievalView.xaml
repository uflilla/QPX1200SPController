<UserControl
    x:Class="QPX1200SPController.Views.DataRetrievalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:QPX1200SPController.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{Binding DataRetrieval, Source={StaticResource Locator}}"
    mc:Ignorable="d">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,10"
            HorizontalAlignment="Center"
            FontSize="20"
            FontWeight="Bold"
            Text="DATA LOGS" />

        <!--  Filter Controls  -->
        <Grid Grid.Row="1" Margin="0,0,0,10" HorizontalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0" FontSize="18"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="Start Date/Time:" />
            <xctk:DateTimePicker
                Grid.Column="1"
                Margin="0,0,10,0"
                FontSize="18" VerticalAlignment="Center"
                Format="Custom" HorizontalAlignment="Left" MinWidth="220"
                FormatString="yyyy-MM-dd HH:mm:ss"
                Value="{Binding StartDate}" />

            <TextBlock
                Grid.Column="2" FontSize="18"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Text="End Date/Time:" />
            <xctk:DateTimePicker
                Grid.Column="3" HorizontalAlignment="Left"
                Margin="0,0,10,0" MinWidth="220"
                FontSize="18" VerticalAlignment="Center"
                Format="Custom"
                FormatString="yyyy-MM-dd HH:mm:ss"
                Value="{Binding EndDate}" />


            <Button
                Grid.Column="4"
                Padding="10,5"
                Command="{Binding LoadDataCommand}"
                Content="Load Data" />
            <Button
                Grid.Column="5"
                Padding="10,5"
                Command="{Binding ExportToCsvCommand}"
                Content="Export to CSV" />
        </Grid>

        <!--  Data Grid  -->
        <DataGrid
            Grid.Row="2"
            Margin="0,10"
            AlternatingRowBackground="#F0F0F0"
            AutoGenerateColumns="False"
            EnableRowVirtualization="True"
            IsReadOnly="True"
            ItemsSource="{Binding Logs}">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Width="150"
                    Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
                    Header="Timestamp" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Voltage, StringFormat='{}{0:F3}'}"
                    Header="Voltage (V)" />
                <DataGridTextColumn
                    Width="100"
                    Binding="{Binding Current, StringFormat='{}{0:F3}'}"
                    Header="Current (A)" />
                <DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding OutputEnabled}"
                    Header="Output" />
                <DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding CvMode}"
                    Header="CV Mode" />
                <DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding CcMode}"
                    Header="CC Mode" />
                <DataGridCheckBoxColumn
                    Width="100"
                    Binding="{Binding UnregulatedMode}"
                    Header="Unregulated Mode" />
                <DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding OvpTrip}"
                    Header="OVP Trip" />
                <DataGridCheckBoxColumn
                    Width="70"
                    Binding="{Binding OcpTrip}"
                    Header="OCP Trip" />

            </DataGrid.Columns>
        </DataGrid>

        <!--  Status Bar  -->
        <StatusBar Grid.Row="3">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <ProgressBar
                    Width="100"
                    Height="15"
                    IsIndeterminate="{Binding IsLoading}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>