<UserControl
  x:Class="QPX1200SPController.Views.HistoryView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
  xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
  d:DesignHeight="700"
  d:DesignWidth="1200"
  DataContext="{Binding History, Source={StaticResource Locator}}"
  mc:Ignorable="d">
  <Grid Margin="8">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!--  Range and options  -->
    <materialDesign:Card
      Grid.Row="0"
      Margin="0,0,0,8"
      Padding="12,8"
      materialDesign:ElevationAssist.Elevation="Dp2">
      <WrapPanel VerticalAlignment="Center">
        <ItemsControl VerticalAlignment="Center" ItemsSource="{Binding Presets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button
                Height="28"
                Margin="0,0,4,0"
                Padding="10,0"
                Command="{Binding DataContext.PresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}"
                Content="{Binding}"
                FontSize="12"
                Style="{StaticResource MaterialDesignOutlinedButton}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock
          Margin="12,0,6,0"
          VerticalAlignment="Center"
          Text="From" />
        <xctk:DateTimePicker
          Width="190"
          VerticalAlignment="Center"
          Format="Custom"
          FormatString="yyyy-MM-dd HH:mm:ss"
          Value="{Binding From}" />
        <TextBlock
          Margin="8,0,6,0"
          VerticalAlignment="Center"
          Text="To" />
        <xctk:DateTimePicker
          Width="190"
          VerticalAlignment="Center"
          Format="Custom"
          FormatString="yyyy-MM-dd HH:mm:ss"
          Value="{Binding To}" />
        <Button
          Height="28"
          Margin="8,0,16,0"
          Command="{Binding LoadCommand}"
          Content="LOAD"
          Style="{StaticResource MaterialDesignRaisedButton}" />

        <TextBlock
          Margin="0,0,6,0"
          VerticalAlignment="Center"
          FontWeight="SemiBold"
          Text="Markers" />
        <CheckBox
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Content="Commands"
          Foreground="{DynamicResource CommandMarkerBrush}"
          IsChecked="{Binding ShowCommands}" />
        <CheckBox
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Content="Connection"
          Foreground="{DynamicResource ConnectionMarkerBrush}"
          IsChecked="{Binding ShowConnection}" />
        <CheckBox
          Margin="0,0,16,0"
          VerticalAlignment="Center"
          Content="Errors"
          Foreground="{DynamicResource ErrorBrush}"
          IsChecked="{Binding ShowErrors}" />
        <CheckBox
          x:Name="AutoYCheckBox"
          Margin="0,0,16,0"
          VerticalAlignment="Center"
          Content="Auto Y"
          IsChecked="True"
          ToolTip="Fit the Y axes to the data after every zoom or pan" />
        <CheckBox
          Margin="0,0,16,0"
          VerticalAlignment="Center"
          AutomationProperties.Name="Auto refresh"
          Content="Auto refresh"
          IsChecked="{Binding IsAutoRefresh}"
          ToolTip="Every 5 s, move the shown window (same length) to end now. Zooming or panning switches it off." />

        <Button
          Height="28"
          Margin="0,0,4,0"
          Command="{Binding ResetZoomCommand}"
          Style="{StaticResource MaterialDesignOutlinedButton}"
          AutomationProperties.Name="Reset zoom"
          ToolTip="Back to the loaded range">
          <materialDesign:PackIcon Kind="MagnifyMinusOutline" />
        </Button>
        <Button
          Height="28"
          Margin="0,0,4,0"
          Command="{Binding ExportPngCommand}"
          Style="{StaticResource MaterialDesignOutlinedButton}"
          ToolTip="Save the plots as a PNG image">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Margin="0,0,4,0" Kind="ImageOutline" />
            <TextBlock FontSize="12" Text="PNG" />
          </StackPanel>
        </Button>
        <Button
          Height="28"
          Command="{Binding ExportCsvCommand}"
          Style="{StaticResource MaterialDesignOutlinedButton}"
          ToolTip="Export every sample in the visible window to CSV">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon Margin="0,0,4,0" Kind="FileDelimitedOutline" />
            <TextBlock FontSize="12" Text="CSV" />
          </StackPanel>
        </Button>
      </WrapPanel>
    </materialDesign:Card>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="6" />
        <ColumnDefinition Width="320" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <!--  Plots  -->
      <materialDesign:Card
        Grid.Column="0"
        Padding="4"
        materialDesign:ElevationAssist.Elevation="Dp2">
        <Grid x:Name="PlotsContainer" Background="{DynamicResource MaterialDesign.Brush.Card.Background}">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <scottPlot:WpfPlot x:Name="VoltagePlot" Grid.Row="0" />
          <scottPlot:WpfPlot x:Name="CurrentPlot" Grid.Row="1" />
          <scottPlot:WpfPlot x:Name="PowerPlot" Grid.Row="2" />
        </Grid>
      </materialDesign:Card>

      <GridSplitter
        Grid.Column="1"
        Width="6"
        HorizontalAlignment="Stretch"
        Background="Transparent"
        ResizeBehavior="PreviousAndNext" />

      <!--  Side panel  -->
      <DockPanel Grid.Column="2">
        <materialDesign:Card
          Margin="0,0,0,8"
          Padding="12,8"
          materialDesign:ElevationAssist.Elevation="Dp2"
          DockPanel.Dock="Top">
          <StackPanel>
            <TextBlock
              Margin="0,0,0,4"
              Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
              Text="Cursor" />
            <TextBlock
              MinHeight="48"
              FontFamily="Consolas"
              FontSize="12"
              Text="{Binding CursorText}"
              TextWrapping="Wrap" />
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card
          Margin="0,0,0,8"
          Padding="12,8"
          materialDesign:ElevationAssist.Elevation="Dp2"
          DockPanel.Dock="Top">
          <StackPanel>
            <TextBlock
              Margin="0,0,0,4"
              Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
              Text="Visible window" />
            <ItemsControl ItemsSource="{Binding Stats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,1" ToolTip="{Binding Hint}">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="80" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                      FontSize="12"
                      Opacity="0.7"
                      Text="{Binding Label}" />
                    <TextBlock
                      Grid.Column="1"
                      FontFamily="Consolas"
                      FontSize="12"
                      Text="{Binding Value}"
                      TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </materialDesign:Card>

        <materialDesign:Card Padding="4,8" materialDesign:ElevationAssist.Elevation="Dp2">
          <DockPanel>
            <TextBlock
              Margin="8,0,0,4"
              DockPanel.Dock="Top"
              Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
              Text="Events (click to centre)" />
            <TextBlock
              Margin="8,0,8,6"
              DockPanel.Dock="Top"
              FontSize="11"
              Foreground="{DynamicResource WarnBrush}"
              Text="{Binding MarkerNote}"
              TextWrapping="Wrap">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding MarkerNote}" Value="{x:Null}">
                      <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ListBox
              ItemsSource="{Binding Events}"
              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
              SelectedItem="{Binding SelectedEvent}"
              VirtualizingPanel.IsVirtualizing="True">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse
                      x:Name="Dot"
                      Width="8"
                      Height="8"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"
                      Fill="{DynamicResource CommandMarkerBrush}" />
                    <TextBlock
                      FontFamily="Consolas"
                      FontSize="11"
                      Text="{Binding Timestamp, StringFormat='{}{0:MM-dd HH:mm:ss}'}" />
                    <TextBlock
                      Margin="6,0,0,0"
                      FontSize="12"
                      Text="{Binding Summary}"
                      TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Kind}" Value="Connection">
                      <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ConnectionMarkerBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Result}" Value="Mismatch">
                      <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Result}" Value="Failed">
                      <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Result}" Value="Lost">
                      <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Result}" Value="Raised">
                      <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Result}" Value="Cleared">
                      <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource WarnBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Result}" Value="Connect failed">
                      <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </materialDesign:Card>
      </DockPanel>
    </Grid>

    <!--  Status  -->
    <DockPanel Grid.Row="2" Margin="4,8,4,0">
      <ProgressBar
        Width="120"
        Height="4"
        Margin="12,0,0,0"
        DockPanel.Dock="Right"
        IsIndeterminate="{Binding IsLoading}"
        Style="{StaticResource MaterialDesignLinearProgressBar}"
        Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
      <TextBlock
        Opacity="0.85"
        Text="{Binding StatusText}"
        TextTrimming="CharacterEllipsis" />
    </DockPanel>
  </Grid>
</UserControl>
