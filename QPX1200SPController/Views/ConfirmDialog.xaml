<Window
  x:Class="QPX1200SPController.Views.ConfirmDialog"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  Title="Confirm"
  Width="460"
  Background="{DynamicResource MaterialDesign.Brush.Background}"
  FontFamily="{materialDesign:MaterialDesignFont}"
  ResizeMode="NoResize"
  ShowInTaskbar="False"
  SizeToContent="Height"
  TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
  WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24,20,24,20">
    <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
      <materialDesign:PackIcon
        x:Name="HeaderIcon"
        Width="28"
        Height="28"
        VerticalAlignment="Center"
        Foreground="{DynamicResource WarnBrush}"
        Kind="Power" />
      <TextBlock
        x:Name="HeaderText"
        Margin="10,0,0,0"
        VerticalAlignment="Center"
        Style="{StaticResource MaterialDesignHeadline6TextBlock}" />
    </StackPanel>
    <TextBlock
      x:Name="MessageText"
      Margin="0,0,0,12"
      TextWrapping="Wrap" />
    <Border
      x:Name="DetailBorder"
      Margin="0,0,0,16"
      Padding="12,8"
      BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
      BorderThickness="1"
      CornerRadius="6">
      <TextBlock
        x:Name="DetailText"
        FontFamily="Consolas"
        TextWrapping="Wrap" />
    </Border>
    <CheckBox
      x:Name="DontAskCheckBox"
      Margin="0,0,0,16"
      Content="Don't ask again (can be changed under Soft limits &amp; storage)"
      Visibility="Collapsed" />
    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
      <Button
        Margin="0,0,8,0"
        Click="OnCancelClick"
        Content="CANCEL"
        IsCancel="True"
        IsDefault="True"
        Style="{StaticResource MaterialDesignFlatButton}" />
      <Button
        x:Name="ConfirmButton"
        Background="#2E7D32"
        BorderBrush="#2E7D32"
        Click="OnConfirmClick"
        Foreground="White"
        Style="{StaticResource MaterialDesignRaisedButton}" />
    </StackPanel>
  </StackPanel>
</Window>
