<UserControl
  x:Class="QPX1200SPController.Views.AppLogsView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  d:DesignHeight="450"
  d:DesignWidth="800"
  mc:Ignorable="d">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel
      Grid.Row="0"
      Margin="0,0,0,12"
      HorizontalAlignment="Center"
      Orientation="Horizontal">
      <materialDesign:PackIcon
        Width="28"
        Height="28"
        VerticalAlignment="Center"
        Kind="TextBoxOutline" />
      <TextBlock
        Margin="10,0,0,0"
        VerticalAlignment="Center"
        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
        Text="App Logs" />
    </StackPanel>

    <materialDesign:Card
      Grid.Row="1"
      Margin="0,0,0,12"
      Padding="16,10"
      materialDesign:ElevationAssist.Elevation="Dp2">
      <DockPanel>
        <Button
          Command="{Binding OpenLogFolderCommand}"
          DockPanel.Dock="Right"
          Style="{StaticResource MaterialDesignOutlinedButton}">
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon
              Margin="0,0,6,0"
              VerticalAlignment="Center"
              Kind="FolderOpenOutline" />
            <TextBlock VerticalAlignment="Center" Text="OPEN LOG FOLDER" />
          </StackPanel>
        </Button>
        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
          <ToggleButton
            IsChecked="{Binding IsTraceEnabled}"
            Style="{StaticResource MaterialDesignSwitchToggleButton}"
            ToolTip="Capture every command and response to a trace file" />
          <TextBlock
            Margin="10,0,12,0"
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="Trace mode" />
          <ComboBox
            Width="100"
            Margin="0,0,16,0"
            VerticalAlignment="Center"
            DisplayMemberPath="DisplayName"
            IsEnabled="{Binding IsTraceEnabled, Converter={StaticResource InverseBoolConverter}}"
            ItemsSource="{Binding TraceDurations}"
            SelectedItem="{Binding SelectedTraceDuration}"
            Style="{StaticResource MaterialDesignComboBox}"
            ToolTip="Trace switches itself off after this time" />
          <TextBlock
            VerticalAlignment="Center"
            Opacity="0.8"
            Text="{Binding TraceStatusText}"
            TextTrimming="CharacterEllipsis" />
        </StackPanel>
      </DockPanel>
    </materialDesign:Card>

    <materialDesign:Card
      Grid.Row="2"
      materialDesign:ElevationAssist.Elevation="Dp2">
      <DataGrid
        Margin="8"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        IsReadOnly="True"
        ItemsSource="{Binding Logs}"
        Style="{StaticResource MaterialDesignDataGrid}">
        <DataGrid.Columns>
          <DataGridTextColumn
            Width="160"
            Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss.fff}'}"
            Header="Timestamp" />
          <DataGridTextColumn
            Width="80"
            Binding="{Binding Level}"
            Header="Level" />
          <DataGridTextColumn
            Width="120"
            Binding="{Binding ClassName}"
            Header="Class" />
          <DataGridTextColumn
            Width="120"
            Binding="{Binding MethodName}"
            Header="Method" />
          <DataGridTemplateColumn Width="*" Header="Message">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>
    </materialDesign:Card>
  </Grid>
</UserControl>
