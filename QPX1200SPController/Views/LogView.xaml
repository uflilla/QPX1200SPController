<UserControl
  x:Class="QPX1200SPController.Views.LogView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
  d:DesignHeight="450"
  d:DesignWidth="800"
  DataContext="{Binding Log, Source={StaticResource Locator}}"
  mc:Ignorable="d">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel
      Grid.Row="0"
      Margin="0,0,0,12"
      HorizontalAlignment="Center"
      Orientation="Horizontal">
      <materialDesign:PackIcon
        Width="28"
        Height="28"
        VerticalAlignment="Center"
        Kind="FileDocumentOutline" />
      <TextBlock
        Margin="10,0,0,0"
        VerticalAlignment="Center"
        Style="{StaticResource MaterialDesignHeadline5TextBlock}"
        Text="Data Logs" />
    </StackPanel>

    <materialDesign:Card
      Grid.Row="1"
      Margin="0,0,0,12"
      Padding="16"
      materialDesign:ElevationAssist.Elevation="Dp2">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock
          Grid.Column="0"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Text="Start Date/Time" />
        <xctk:DateTimePicker
          Grid.Column="1"
          Margin="0,0,12,0"
          Format="Custom"
          FormatString="yyyy-MM-dd HH:mm:ss"
          Value="{Binding StartDate}" />

        <TextBlock
          Grid.Column="2"
          Margin="0,0,8,0"
          VerticalAlignment="Center"
          Text="End Date/Time" />
        <xctk:DateTimePicker
          Grid.Column="3"
          Margin="0,0,12,0"
          Format="Custom"
          FormatString="yyyy-MM-dd HH:mm:ss"
          Value="{Binding EndDate}" />

        <Button
          Grid.Column="4"
          Margin="0,0,8,0"
          Command="{Binding LoadLogsCommand}"
          Content="LOAD DATA"
          Style="{StaticResource MaterialDesignRaisedButton}" />
        <Button
          Grid.Column="5"
          Command="{Binding ExportToCsvCommand}"
          Content="EXPORT CSV"
          Style="{StaticResource MaterialDesignOutlinedButton}" />
      </Grid>
    </materialDesign:Card>

    <materialDesign:Card
      Grid.Row="2"
      materialDesign:ElevationAssist.Elevation="Dp2">
      <DataGrid
        Margin="8"
        AutoGenerateColumns="False"
        CanUserAddRows="False"
        IsReadOnly="True"
        ItemsSource="{Binding Logs}"
        Style="{StaticResource MaterialDesignDataGrid}">
        <DataGrid.Columns>
          <DataGridTextColumn
            Width="160"
            Binding="{Binding Timestamp, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}"
            Header="Timestamp" />
          <DataGridTextColumn
            Width="100"
            Binding="{Binding Voltage, StringFormat='{}{0:F3}'}"
            Header="Voltage (V)" />
          <DataGridTextColumn
            Width="100"
            Binding="{Binding Current, StringFormat='{}{0:F3}'}"
            Header="Current (A)" />
          <DataGridTextColumn
            Width="100"
            Binding="{Binding Power, StringFormat='{}{0:F2}'}"
            Header="Power (W)" />
          <DataGridCheckBoxColumn
            Width="70"
            Binding="{Binding OutputEnabled}"
            Header="Output" />
          <DataGridCheckBoxColumn
            Width="50"
            Binding="{Binding OverVoltageProtection}"
            Header="OVP" />
          <DataGridCheckBoxColumn
            Width="50"
            Binding="{Binding OverCurrentProtection}"
            Header="OCP" />
        </DataGrid.Columns>
      </DataGrid>
    </materialDesign:Card>

    <materialDesign:ColorZone
      Grid.Row="3"
      Margin="0,12,0,0"
      Padding="12,8"
      Mode="Standard">
      <DockPanel>
        <TextBlock
          VerticalAlignment="Center"
          Text="{Binding StatusMessage}" />
        <ProgressBar
          Width="120"
          Height="4"
          Margin="16,0,0,0"
          HorizontalAlignment="Right"
          DockPanel.Dock="Right"
          IsIndeterminate="{Binding IsLoading}"
          Style="{StaticResource MaterialDesignLinearProgressBar}"
          Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />
      </DockPanel>
    </materialDesign:ColorZone>
  </Grid>
</UserControl>
