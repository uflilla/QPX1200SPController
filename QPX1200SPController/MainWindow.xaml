<Window
    x:Class="QPX1200SPController.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:View="clr-namespace:QPX1200SPController.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:QPX1200SPController"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:QPX1200SPController.ViewModels"
    xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
    Title="QPX1200SP Power Supply Controller"
    DataContext="{Binding Main, Source={StaticResource Locator}}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Margin" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="MinWidth" Value="80" />
        </Style>
    </Window.Resources>
    <TabControl>
        <TabItem Header="Monitoring &amp; Control">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Connection Panel  -->
                <Border
                    Grid.Row="0"
                    Padding="5"
                    BorderBrush="Gray"
                    BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            FontWeight="Bold"
                            Text="IP Address:" />
                        <TextBox
                            Grid.Column="1"
                            FontSize="16"
                            Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            Grid.Column="2"
                            Command="{Binding ConnectCommand}"
                            Content="Connect"
                            IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}" />
                        <Button
                            Grid.Column="3"
                            Command="{Binding DisconnectCommand}"
                            Content="Disconnect"
                            IsEnabled="{Binding IsConnected}" />
                        <TextBlock
                            Grid.Column="4"
                            Margin="5"
                            Text="{Binding SupplyName, TargetNullValue='---'}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding SupplyName}" />

                        <TextBlock
                            Grid.Column="5"
                            Margin="10,0"
                            VerticalAlignment="Center"
                            FontWeight="Bold"
                            Text="{Binding ConnectionStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="OrangeRed"></Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStatus}" Value="Connected">
                                            <Setter Property="Foreground" Value="ForestGreen" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!--  Main Content  -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" MaxWidth="350" />
                    </Grid.ColumnDefinitions>

                    <!--  Live Display Panel  -->
                    <Border
                        Grid.Column="0"
                        Padding="10"
                        BorderBrush="Gray"
                        BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Foreground="DarkOrange"
                                Text="{Binding Status.Time, TargetNullValue='---'}" />

                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Voltage Display  -->
                                <Border
                                    Grid.Row="0"
                                    Margin="5"
                                    Background="{Binding Status.OutputEnabled, Converter={StaticResource OutputEnabledToBrushConverter}}"
                                    BorderBrush="DarkGray"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Text="VOLTAGE (V)" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="10,0,10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Text="{Binding PowerSupplySettingStatus.SetVoltage, StringFormat='Set: {0:F2}V', TargetNullValue='---'}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Text="{Binding PowerSupplySettingStatus.SetOvpLevel, StringFormat='OVP: {0:F2}V', TargetNullValue='---'}" />
                                        <Viewbox
                                            Grid.Row="1"
                                            VerticalAlignment="Center"
                                            Stretch="Uniform">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="120"
                                                FontWeight="Bold"
                                                Text="{Binding Status.Voltage, StringFormat='{}{0:F3}'}" />
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <!--  Current Display  -->
                                <Border
                                    Grid.Row="1"
                                    Margin="5"
                                    Background="{Binding Status.OutputEnabled, Converter={StaticResource OutputEnabledToBrushConverter}}"
                                    BorderBrush="DarkGray"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Text="CURRENT (A)" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="10,0,10,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Text="{Binding PowerSupplySettingStatus.SetCurrent, StringFormat='Set: {0:F2}A', TargetNullValue='---'}" />
                                        <TextBlock
                                            Grid.Row="1"
                                            Margin="0,0,10,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Text="{Binding PowerSupplySettingStatus.SetOcpLevel, StringFormat='OCP: {0:F2}A', TargetNullValue='---'}" />
                                        <Viewbox
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Stretch="Uniform">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="120"
                                                FontWeight="Bold"
                                                Text="{Binding Status.Current, StringFormat={}{0:F3}}" />
                                        </Viewbox>
                                    </Grid>
                                </Border>

                                <!--  Power Display  -->
                                <Border
                                    Grid.Row="2"
                                    Margin="5"
                                    Background="{Binding Status.OutputEnabled, Converter={StaticResource OutputEnabledToBrushConverter}}"
                                    BorderBrush="DarkGray"
                                    BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Margin="10,5,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Text="POWER (W)" />

                                        <Viewbox
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Stretch="Uniform">
                                            <TextBlock
                                                HorizontalAlignment="Center"
                                                FontSize="120"
                                                FontWeight="Bold"
                                                Text="{Binding Status.Power, StringFormat={}{0:F2}}" />
                                        </Viewbox>
                                    </Grid>
                                </Border>
                            </Grid>


                        </Grid>
                    </Border>

                    <!--  Control Panel  -->
                    <Border Grid.Column="1" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                Grid.Row="0"
                                Margin="0,0,0,5"
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="CONTROL PANEL" />

                            <!--  Voltage Control  -->
                            <GroupBox
                                Grid.Row="1"
                                Margin="0,5,0,5"
                                Padding="5"
                                Header="Voltage Control">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <xceed:DoubleUpDown
                                        FontSize="16"
                                        Increment="0.1"
                                        Maximum="{Binding MaxVoltageToSet}"
                                        Minimum="{Binding MinVoltageToSet}"
                                        TextAlignment="Right"
                                        Value="{Binding VoltageToSet}" />
                                    <!--<TextBox
                                        Grid.Column="0"
                                        HorizontalAlignment="Stretch"
                                        Text="{Binding SetVoltage, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}"
                                        TextAlignment="Right" />-->
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="V" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Command="{Binding SetVoltageCommand}"
                                        Content="Set">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VoltageToSet}" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsVoltageValid}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </GroupBox>

                            <!--  Current Control  -->
                            <GroupBox
                                Grid.Row="2"
                                Margin="0,5,0,5"
                                Padding="10"
                                Header="Current Control">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <xceed:DoubleUpDown
                                        FontSize="16"
                                        Increment="0.1"
                                        Maximum="{Binding MaxCurrentToSet}"
                                        Minimum="{Binding MinCurrentToSet}"
                                        TextAlignment="Right"
                                        Value="{Binding CurrentToSet}" />
                                    <!--<TextBox
                                        Grid.Column="0"
                                        Width="120"
                                        HorizontalAlignment="Left"
                                        Text="{Binding SetCurrent, StringFormat={}{0:F2}, UpdateSourceTrigger=PropertyChanged}" />-->
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="A" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Command="{Binding SetCurrentCommand}"
                                        Content="Set">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CurrentToSet}" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsCurrentValid}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </GroupBox>
                            <!--  Over Voltage Protection Control  -->
                            <GroupBox
                                Grid.Row="3"
                                Margin="0,5,0,5"
                                Padding="10"
                                Header="Over Voltage Protection Control">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <xceed:DoubleUpDown
                                        FontSize="16"
                                        Increment="0.1"
                                        Maximum="{Binding MaxOvpToSet}"
                                        Minimum="{Binding MinOvpToSet}"
                                        TextAlignment="Right"
                                        Value="{Binding OvpToSet}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="A" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Command="{Binding SetOvpCommand}"
                                        Content="Set">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OvpToSet}" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOvpValid}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </GroupBox>
                            <!--  OverCurrent Protection Control  -->
                            <GroupBox
                                Grid.Row="4"
                                Margin="0,5,0,5"
                                Padding="10"
                                Header="OverCurrent Protection Control">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <xceed:DoubleUpDown
                                        FontSize="16"
                                        Increment="0.1"
                                        Maximum="{Binding MaxOcpToSet}"
                                        Minimum="{Binding MinOcpToSet}"
                                        TextAlignment="Right"
                                        Value="{Binding OcpToSet}" />

                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="A" />
                                    <Button
                                        Grid.Column="2"
                                        Margin="10,0,0,0"
                                        Command="{Binding SetOcpCommand}"
                                        Content="Set">
                                        <Button.Style>
                                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding OcpToSet}" Value="{x:Null}">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOcpValid}" Value="False">
                                                        <Setter Property="IsEnabled" Value="False" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </GroupBox>
                            <!--  Protection Status  -->

                            <GroupBox
                                Grid.Row="5"
                                Margin="0,10,0,0"
                                Padding="10"
                                Header="Power Supply Event Status">
                                <UniformGrid
                                    VerticalAlignment="Top"
                                    Columns="3"
                                    Rows="2">
                                    <StackPanel>
                                        <Ellipse
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            Fill="{Binding EventStatus.ConstantVoltageMode, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                                        <TextBlock HorizontalAlignment="Center" Text="CV Mode" />
                                    </StackPanel>
                                    <StackPanel>
                                        <Ellipse
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            Fill="{Binding EventStatus.ConstantCurrentMode, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                                        <TextBlock HorizontalAlignment="Center" Text="CC Mode" />
                                    </StackPanel>
                                    <StackPanel>
                                        <Ellipse
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            Fill="{Binding EventStatus.UnregulatedMode, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                                        <TextBlock HorizontalAlignment="Center" Text="Unregulated" />
                                    </StackPanel>
                                    <StackPanel>
                                        <Ellipse
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            Fill="{Binding EventStatus.OverVoltageTrip, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                                        <TextBlock HorizontalAlignment="Center" Text="OVP Trip" />
                                    </StackPanel>
                                    <StackPanel>
                                        <Ellipse
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            Fill="{Binding EventStatus.OverCurrentTrip, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                                        <TextBlock HorizontalAlignment="Center" Text="OCP Trip" />
                                    </StackPanel>
                                    <StackPanel>
                                        <Ellipse
                                            Width="20"
                                            Height="20"
                                            HorizontalAlignment="Center"
                                            Fill="{Binding EventStatus.FaultTrip, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                                        <TextBlock HorizontalAlignment="Center" Text="Fault Trip" />
                                    </StackPanel>
                                </UniformGrid>

                            </GroupBox>

                            <!--  Additional Controls can be added here  -->
                            <GroupBox
                                Grid.Row="6"
                                Margin="0,5,0,0"
                                Padding="10"
                                VerticalAlignment="Top"
                                Header="Misc Control">
                                <!--  Output Status  -->
                                <UniformGrid Columns="3">
                                    <Button
                                        Padding="10,5"
                                        Command="{Binding SendMiscCommand}"
                                        CommandParameter="TRIPRST"
                                        Content="TRIP Reset" />
                                    <Button
                                        Padding="10,5"
                                        Command="{Binding SendMiscCommand}"
                                        CommandParameter="LOCAL"
                                        Content="LOCAL" />
                                </UniformGrid>
                            </GroupBox>
                            <!--  Output ON/OFF  -->
                            <GroupBox
                                Grid.Row="7"
                                Margin="0,10,0,0"
                                Padding="10"
                                Header="Output">
                                <!--  Output Status  -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Text="Status:" />
                                        <TextBlock
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Foreground="{Binding Status.OutputEnabled, Converter={StaticResource OutputEnabledToForegroundConverter}}"
                                            Text="{Binding Status.OutputEnabled, Converter={StaticResource BoolToOnOffConverter}}" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        Padding="15,8"
                                        Background="{Binding Status.OutputEnabled, Converter={StaticResource OutputButtonBackgroundConverter}}"
                                        Command="{Binding ToggleOutputCommand}"
                                        Content="{Binding Status.OutputEnabled, Converter={StaticResource OutputButtonTextConverter}}"
                                        FontWeight="Bold" />
                                </Grid>
                            </GroupBox>

                            <CheckBox
                                Grid.Row="8"
                                Margin="3"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                IsChecked="{Binding IsInConfigMode}">
                                Enable Configuration
                            </CheckBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>



        <!--  Settings Tab  -->
        <TabItem Header="Settings">
            <View:Settings />
        </TabItem>
        <!--  Logs Tab  -->
        <TabItem Header="Data Logs">
            <View:DataRetrievalView />
        </TabItem>
        <TabItem Header="App Logs">
            <View:AppLogsView />
        </TabItem>
    </TabControl>
</Window>