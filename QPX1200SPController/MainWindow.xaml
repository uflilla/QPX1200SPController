<Window
  x:Class="QPX1200SPController.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:View="clr-namespace:QPX1200SPController.Views"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
  xmlns:vm="clr-namespace:QPX1200SPController.ViewModels"
  xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
  Title="QPX1200SP Power Supply Controller"
  Width="1360"
  Height="860"
  MinWidth="1000"
  MinHeight="660"
  Background="{DynamicResource MaterialDesign.Brush.Background}"
  DataContext="{Binding Main, Source={StaticResource Locator}}"
  FontFamily="{materialDesign:MaterialDesignFont}"
  Loaded="MainWindow_OnLoaded"
  Style="{StaticResource MaterialDesignWindow}"
  TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">

  <Window.Resources>
    <Style
      x:Key="CompactRaisedButton"
      BasedOn="{StaticResource MaterialDesignRaisedButton}"
      TargetType="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style
      x:Key="CompactOutlinedButton"
      BasedOn="{StaticResource MaterialDesignOutlinedButton}"
      TargetType="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style
      x:Key="CompactTabItem"
      BasedOn="{StaticResource MaterialDesignTabItem}"
      TargetType="TabItem">
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <!--  Small rounded label used for the header chips and the status-register indicators  -->
    <Style x:Key="ChipBorder" TargetType="Border">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <Style x:Key="SetButton" BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Content" Value="SET" />
    </Style>

    <Style x:Key="SetPointInput" TargetType="xceed:DoubleUpDown" BasedOn="{StaticResource {x:Type xceed:DoubleUpDown}}">
      <Setter Property="Height" Value="30" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FormatString" Value="F3" />
      <Setter Property="Increment" Value="0.1" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!--  Overlay with the Y-axis mode on top of each live plot  -->
    <Style x:Key="PlotOverlay" TargetType="Border">
      <Setter Property="Margin" Value="0,6,8,0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Panel.ZIndex" Value="1" />
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OverlayBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <DataTemplate x:Key="YAxisOverlayTemplate" DataType="{x:Type vm:PlotYAxisSettings}">
      <StackPanel Orientation="Horizontal">
        <TextBlock
          Margin="0,0,6,0"
          VerticalAlignment="Center"
          FontSize="11"
          Opacity="0.75"
          Text="Y" />
        <ComboBox
          Width="78"
          VerticalAlignment="Center"
          FontSize="12"
          ItemsSource="{Binding DataContext.YAxisScaleModes, RelativeSource={RelativeSource AncestorType=Window}}"
          SelectedItem="{Binding Mode}"
          Style="{StaticResource MaterialDesignComboBox}" />
        <StackPanel
          Margin="6,0,0,0"
          Orientation="Horizontal"
          Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibilityConverter}}">
          <xceed:DoubleUpDown
            Width="70"
            VerticalAlignment="Center"
            FontSize="12"
            FormatString="F2"
            Increment="0.1"
            ToolTip="Y-axis lower value"
            Value="{Binding YMin, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock
            Margin="4,0"
            VerticalAlignment="Center"
            Opacity="0.75"
            Text="–" />
          <xceed:DoubleUpDown
            Width="70"
            VerticalAlignment="Center"
            FontSize="12"
            FormatString="F2"
            Increment="0.1"
            ToolTip="Y-axis upper value"
            Value="{Binding YMax, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <materialDesign:DialogHost Identifier="RootDialog">
    <DockPanel>

      <!--  ===== Header =====  -->
      <Border
        Padding="14,8"
        Background="{DynamicResource HeaderBrush}"
        DockPanel.Dock="Top"
        TextElement.Foreground="White">
        <DockPanel>
          <Border
            Width="36"
            Height="36"
            Background="#33FFFFFF"
            CornerRadius="18"
            DockPanel.Dock="Left">
            <materialDesign:PackIcon
              Width="22"
              Height="22"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="#FFD54F"
              Kind="Flash" />
          </Border>
          <StackPanel
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Left">
            <TextBlock FontSize="16" FontWeight="SemiBold">
              <Run Text="QPX1200SP" />
              <Run FontSize="13" FontWeight="Normal" Text="  Monitoring &amp; Control" />
            </TextBlock>
            <TextBlock
              FontSize="11"
              Opacity="0.8"
              Text="{Binding SupplyName, TargetNullValue='No supply connected', FallbackValue='No supply connected'}"
              TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SupplyName}" Value="">
                      <Setter Property="Text" Value="No supply connected" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <Button
            Width="36"
            Height="36"
            Margin="12,0,0,0"
            Padding="0"
            AutomationProperties.Name="Switch theme"
            Command="{Binding ToggleThemeCommand}"
            DockPanel.Dock="Right"
            Foreground="White"
            Style="{StaticResource MaterialDesignIconButton}"
            ToolTip="Switch between dark and light theme">
            <materialDesign:PackIcon Width="20" Height="20">
              <materialDesign:PackIcon.Style>
                <Style TargetType="materialDesign:PackIcon">
                  <Setter Property="Kind" Value="WeatherSunny" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                      <Setter Property="Kind" Value="WeatherNight" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>
          </Button>

          <!--  Output chip  -->
          <Border
            Margin="10,0,0,0"
            AutomationProperties.Name="Output state"
            DockPanel.Dock="Right">
            <Border.Style>
              <Style BasedOn="{StaticResource ChipBorder}" TargetType="Border">
                <Setter Property="Background" Value="#26FFFFFF" />
                <Setter Property="BorderBrush" Value="#66FFFFFF" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsConnected}" Value="True" />
                      <Condition Binding="{Binding Status.OutputEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#43A047" />
                    <Setter Property="BorderBrush" Value="#A5D6A7" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon
                Width="14"
                Height="14"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Kind="Power" />
              <TextBlock FontSize="12" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="OUTPUT ---" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsConnected}" Value="True" />
                          <Condition Binding="{Binding Status.OutputEnabled}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Text" Value="OUTPUT ON" />
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsConnected}" Value="True" />
                          <Condition Binding="{Binding Status.OutputEnabled}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Text" Value="OUTPUT OFF" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <!--  Connection chip  -->
          <Border DockPanel.Dock="Right" AutomationProperties.Name="Connection state">
            <Border.Style>
              <Style BasedOn="{StaticResource ChipBorder}" TargetType="Border">
                <Setter Property="Background" Value="#26FFFFFF" />
                <Setter Property="BorderBrush" Value="#66FFFFFF" />
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Ellipse
                Width="9"
                Height="9"
                Margin="0,0,6,0"
                VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#EF9A9A" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Fill" Value="#69F0AE" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                        <Setter Property="Fill" Value="#FFD740" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding ConnectionStatus}" />
            </StackPanel>
          </Border>
          <Grid />
        </DockPanel>
      </Border>

      <!--  ===== Alarm banner (all tabs) =====  -->
      <Border
        Padding="14,6"
        AutomationProperties.Name="Alarm banner"
        Background="{DynamicResource ErrorBrush}"
        DataContext="{Binding Alarms, Source={StaticResource Locator}}"
        DockPanel.Dock="Top"
        TextElement.Foreground="White"
        ToolTip="{Binding BannerToolTip}"
        Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibilityConverter}}">
        <DockPanel>
          <Button
            Height="28"
            Padding="12,0"
            AutomationProperties.Name="Acknowledge alarms"
            BorderBrush="White"
            Command="{Binding AcknowledgeCommand}"
            Content="ACKNOWLEDGE"
            DockPanel.Dock="Right"
            FontSize="12"
            Foreground="White"
            Style="{StaticResource MaterialDesignOutlinedButton}" />
          <materialDesign:PackIcon
            Width="20"
            Height="20"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Kind="BellAlert" />
          <TextBlock
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="{Binding BannerText}"
            TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>

      <!--  ===== Status bar =====  -->
      <Border
        Padding="12,4"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
        BorderThickness="0,1,0,0"
        DockPanel.Dock="Bottom"
        TextElement.FontSize="12">
        <DockPanel>
          <TextBlock
            DockPanel.Dock="Right"
            Opacity="0.6"
            Text="{Binding VersionText}" />
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon
              Width="14"
              Height="14"
              Margin="0,0,5,0"
              VerticalAlignment="Center"
              Kind="ClockOutline"
              Opacity="0.7" />
            <TextBlock VerticalAlignment="Center" Text="{Binding LastReadingText}" />
            <TextBlock
              Margin="6,0,0,0"
              VerticalAlignment="Center"
              Opacity="0.7"
              Text="{Binding SelectedSampleRate.DisplayName, StringFormat='({0})'}" />

            <Rectangle
              Width="1"
              Margin="14,2"
              Fill="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
            <materialDesign:PackIcon
              Width="14"
              Height="14"
              Margin="0,0,5,0"
              VerticalAlignment="Center">
              <materialDesign:PackIcon.Style>
                <Style TargetType="materialDesign:PackIcon">
                  <Setter Property="Kind" Value="DatabaseCheckOutline" />
                  <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDatabaseFailing}" Value="True">
                      <Setter Property="Kind" Value="DatabaseAlertOutline" />
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>
            <TextBlock VerticalAlignment="Center" Text="{Binding DatabaseStatusText}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDatabaseFailing}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSequenceRunning, Converter={StaticResource BoolToVisibilityConverter}}">
              <Rectangle
                Width="1"
                Margin="14,2"
                Fill="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
              <materialDesign:PackIcon
                Width="14"
                Height="14"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                Kind="PlaylistPlay" />
              <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                Text="{Binding SequenceStatusText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTraceOn, Converter={StaticResource BoolToVisibilityConverter}}">
              <Rectangle
                Width="1"
                Margin="14,2"
                Fill="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
              <materialDesign:PackIcon
                Width="14"
                Height="14"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource WarnBrush}"
                Kind="RecordRec" />
              <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource WarnBrush}"
                Text="{Binding TraceStatusText}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!--  ===== Tabs =====  -->
      <TabControl
        Padding="0"
        materialDesign:ColorZoneAssist.Mode="Standard"
        ItemContainerStyle="{StaticResource CompactTabItem}"
        Style="{StaticResource MaterialDesignTabControl}">
        <TabItem AutomationProperties.Name="Monitoring &amp; Control">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="Gauge" />
              <TextBlock VerticalAlignment="Center" Text="Monitoring &amp; Control" />
            </StackPanel>
          </TabItem.Header>
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Connection bar  -->
            <materialDesign:Card
              Grid.Row="0"
              Margin="10,8,10,4"
              Padding="12,6"
              materialDesign:ElevationAssist.Elevation="Dp1">
              <DockPanel>
                <Button
                  Margin="8,0,0,0"
                  Command="{Binding ToggleControlPanelCommand}"
                  DockPanel.Dock="Right"
                  Style="{StaticResource CompactOutlinedButton}"
                  ToolTip="{Binding ControlPanelToggleText}">
                  <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                      Width="16"
                      Height="16"
                      Margin="0,0,4,0"
                      VerticalAlignment="Center"
                      Kind="TuneVariant" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding ControlPanelToggleText}" />
                  </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal">
                  <materialDesign:PackIcon
                    Width="18"
                    Height="18"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Kind="LanConnect"
                    Opacity="0.8" />
                  <ComboBox
                    Width="170"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    materialDesign:HintAssist.Hint="IP address"
                    AutomationProperties.Name="IP address"
                    FontSize="13"
                    IsEditable="True"
                    ItemsSource="{Binding RecentIpAddresses}"
                    Style="{StaticResource MaterialDesignComboBox}"
                    Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Type an address or pick a recent one" />
                  <Button
                    Margin="0,0,6,0"
                    Command="{Binding ConnectCommand}"
                    Content="CONNECT"
                    Style="{StaticResource CompactRaisedButton}" />
                  <Button
                    Margin="0,0,18,0"
                    Command="{Binding DisconnectCommand}"
                    Content="DISCONNECT"
                    Style="{StaticResource CompactOutlinedButton}"
                    ToolTip="Disconnect (unlock the controls first)" />
                  <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Opacity="0.8"
                    Text="Sample rate" />
                  <ComboBox
                    Width="80"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Sample rate"
                    DisplayMemberPath="DisplayName"
                    FontSize="12"
                    ItemsSource="{Binding SampleRates}"
                    SelectedItem="{Binding SelectedSampleRate}"
                    Style="{StaticResource MaterialDesignComboBox}"
                    ToolTip="How often the supply is read and logged to the database" />
                </StackPanel>
              </DockPanel>
            </materialDesign:Card>

            <!--  Main: Meters | Graphs | Controls  -->
            <Grid
              x:Name="MainContentGrid"
              Grid.Row="1"
              Margin="6,0,6,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  x:Name="DigitalColumn"
                  Width="5*"
                  MinWidth="230" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition
                  x:Name="GraphColumn"
                  Width="6*"
                  MinWidth="260" />
                <ColumnDefinition x:Name="ControlSplitterColumn" Width="6" />
                <ColumnDefinition
                  x:Name="ControlColumn"
                  Width="310"
                  MinWidth="260" />
              </Grid.ColumnDefinitions>

              <!--  Meters  -->
              <materialDesign:Card
                Grid.Column="0"
                Margin="4"
                Padding="12"
                materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="1.6*" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <!--  Session counters  -->
                  <DockPanel
                    Grid.Row="4"
                    Margin="2,8,0,0"
                    AutomationProperties.Name="Session counters"
                    TextElement.FontSize="12">
                    <Button
                      Width="26"
                      Height="26"
                      Padding="0"
                      AutomationProperties.Name="Reset counters"
                      Command="{Binding ResetCountersCommand}"
                      DockPanel.Dock="Right"
                      Style="{StaticResource MaterialDesignIconButton}"
                      ToolTip="Reset the session counters">
                      <materialDesign:PackIcon Width="16" Height="16" Kind="Restart" />
                    </Button>
                    <WrapPanel VerticalAlignment="Center">
                      <TextBlock Margin="0,0,14,0" ToolTip="Energy delivered while the output was on">
                        <Run Foreground="{DynamicResource PowerBrush}" Text="Energy" />
                        <Run FontWeight="SemiBold" Text="{Binding EnergyText, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Margin="0,0,14,0" ToolTip="Charge delivered (current × time)">
                        <Run Foreground="{DynamicResource CurrentBrush}" Text="Charge" />
                        <Run FontWeight="SemiBold" Text="{Binding ChargeText, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Margin="0,0,14,0" ToolTip="Time the output was on">
                        <Run Foreground="{DynamicResource OkBrush}" Text="ON time" />
                        <Run FontWeight="SemiBold" Text="{Binding OutputOnTimeText, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Opacity="0.6" Text="{Binding CounterStartText}" />
                    </WrapPanel>
                  </DockPanel>

                  <ItemsControl
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Status indicators"
                    ItemsSource="{Binding StatusFlags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:StatusFlag}">
                        <Border
                          x:Name="Chip"
                          Margin="2"
                          Padding="8,2"
                          AutomationProperties.Name="{Binding Label}"
                          BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                          CornerRadius="10"
                          BorderThickness="1"
                          ToolTip="{Binding Description}">
                          <TextBlock
                            x:Name="ChipText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="{Binding Label}" />
                        </Border>
                        <DataTemplate.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsActive}" Value="True" />
                              <Condition Binding="{Binding Kind}" Value="Good" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource OkBrush}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                            <Setter TargetName="ChipText" Property="Foreground" Value="White" />
                            <Setter TargetName="ChipText" Property="Opacity" Value="1" />
                          </MultiDataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsActive}" Value="True" />
                              <Condition Binding="{Binding Kind}" Value="Notice" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WarnBrush}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                            <Setter TargetName="ChipText" Property="Foreground" Value="Black" />
                            <Setter TargetName="ChipText" Property="Opacity" Value="1" />
                          </MultiDataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsActive}" Value="True" />
                              <Condition Binding="{Binding Kind}" Value="Trip" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ErrorBrush}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                            <Setter TargetName="ChipText" Property="Foreground" Value="White" />
                            <Setter TargetName="ChipText" Property="Opacity" Value="1" />
                          </MultiDataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <View:MeterTile
                    Grid.Row="1"
                    Margin="0,4"
                    Accent="{DynamicResource VoltageBrush}"
                    AutomationProperties.Name="Voltage"
                    FooterLeft="{Binding PowerSupplySettingStatus.SetVoltage, StringFormat='Set {0:F2} V', FallbackValue='Set --- V'}"
                    FooterRight="{Binding PowerSupplySettingStatus.SetOvpLevel, StringFormat='OVP {0:F2} V', FallbackValue='OVP --- V'}"
                    Icon="SineWave"
                    IsLive="{Binding Status.OutputEnabled}"
                    Label="VOLTAGE"
                    Unit="V"
                    Value="{Binding Status.Voltage, StringFormat='{}{0:F3}'}" />
                  <View:MeterTile
                    Grid.Row="2"
                    Margin="0,4"
                    Accent="{DynamicResource CurrentBrush}"
                    AutomationProperties.Name="Current"
                    FooterLeft="{Binding PowerSupplySettingStatus.SetCurrent, StringFormat='Set {0:F2} A', FallbackValue='Set --- A'}"
                    FooterRight="{Binding PowerSupplySettingStatus.SetOcpLevel, StringFormat='OCP {0:F2} A', FallbackValue='OCP --- A'}"
                    Icon="CurrentDc"
                    IsLive="{Binding Status.OutputEnabled}"
                    Label="CURRENT"
                    Unit="A"
                    Value="{Binding Status.Current, StringFormat='{}{0:F3}'}" />
                  <View:MeterTile
                    Grid.Row="3"
                    Margin="0,4,0,0"
                    Accent="{DynamicResource PowerBrush}"
                    AutomationProperties.Name="Power"
                    FooterLeft="{Binding RegulationText}"
                    FooterRight="{Binding LoadText}"
                    Icon="LightningBoltOutline"
                    IsLive="{Binding Status.OutputEnabled}"
                    Label="POWER"
                    Unit="W"
                    Value="{Binding Status.Power, StringFormat='{}{0:F2}'}" />
                </Grid>
              </materialDesign:Card>

              <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True" />

              <!--  Live graphs  -->
              <materialDesign:Card
                Grid.Column="2"
                Margin="4"
                Padding="10"
                materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <DockPanel Grid.Row="0" Margin="2,0,0,6">
                    <StackPanel
                      VerticalAlignment="Center"
                      DockPanel.Dock="Right"
                      Orientation="Horizontal">
                      <ToggleButton
                        AutomationProperties.Name="Follow live"
                        IsChecked="{Binding IsFollowingLive}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}"
                        ToolTip="Keep the plots scrolling with the newest data. Zooming or panning a plot turns this off." />
                      <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Text="Follow live" />
                    </StackPanel>
                    <materialDesign:PackIcon
                      Width="20"
                      Height="20"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      Kind="ChartLine"
                      Opacity="0.8" />
                    <TextBlock
                      VerticalAlignment="Center"
                      FontWeight="SemiBold"
                      Text="Live" />
                    <ComboBox
                      Width="110"
                      Margin="14,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      AutomationProperties.Name="Time window"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding GraphTimeWindows}"
                      SelectedItem="{Binding SelectedGraphTimeWindow}"
                      Style="{StaticResource MaterialDesignComboBox}"
                      ToolTip="Time window shown while following live data" />
                  </DockPanel>

                  <Grid Grid.Row="1" Margin="0,2">
                    <scottPlot:WpfPlot x:Name="VoltagePlot" />
                    <Border Style="{StaticResource PlotOverlay}">
                      <ContentControl Content="{Binding VoltageYAxis}" ContentTemplate="{StaticResource YAxisOverlayTemplate}" />
                    </Border>
                  </Grid>
                  <Grid Grid.Row="2" Margin="0,2">
                    <scottPlot:WpfPlot x:Name="CurrentPlot" />
                    <Border Style="{StaticResource PlotOverlay}">
                      <ContentControl Content="{Binding CurrentYAxis}" ContentTemplate="{StaticResource YAxisOverlayTemplate}" />
                    </Border>
                  </Grid>
                  <Grid Grid.Row="3" Margin="0,2">
                    <scottPlot:WpfPlot x:Name="PowerPlot" />
                    <Border Style="{StaticResource PlotOverlay}">
                      <ContentControl Content="{Binding PowerYAxis}" ContentTemplate="{StaticResource YAxisOverlayTemplate}" />
                    </Border>
                  </Grid>
                </Grid>
              </materialDesign:Card>

              <GridSplitter
                x:Name="ControlSplitter"
                Grid.Column="3"
                Width="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True" />

              <!--  Control panel (visibility driven by code-behind with column widths)  -->
              <materialDesign:Card
                x:Name="ControlPanelBorder"
                Grid.Column="4"
                Margin="4"
                Padding="14,10"
                materialDesign:ElevationAssist.Elevation="Dp1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <!--  Lock  -->
                    <DockPanel>
                      <ToggleButton
                        AutomationProperties.Name="Enable Configuration"
                        DockPanel.Dock="Right"
                        IsChecked="{Binding IsInConfigMode}"
                        Style="{StaticResource MaterialDesignSwitchToggleButton}"
                        ToolTip="Unlock the controls to change the supply's settings" />
                      <materialDesign:PackIcon
                        Width="20"
                        Height="20"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                        <materialDesign:PackIcon.Style>
                          <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="LockOutline" />
                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsInConfigMode}" Value="True">
                                <Setter Property="Kind" Value="LockOpenVariantOutline" />
                                <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </materialDesign:PackIcon.Style>
                      </materialDesign:PackIcon>
                      <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="Controls" />
                        <TextBlock
                          FontSize="11"
                          Opacity="0.7"
                          TextWrapping="Wrap">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Text" Value="Locked - switch on to make changes" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsInConfigMode}" Value="True">
                                  <Setter Property="Text" Value="Unlocked - commands go to the supply" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                    </DockPanel>

                    <!--  Output  -->
                    <Button
                      Height="46"
                      Margin="0,14,0,0"
                      HorizontalAlignment="Stretch"
                      materialDesign:ButtonAssist.CornerRadius="8"
                      AutomationProperties.Name="Toggle output"
                      Command="{Binding ToggleOutputCommand}"
                      FontSize="15"
                      FontWeight="Bold"
                      Foreground="White">
                      <Button.Style>
                        <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                          <Setter Property="Background" Value="#2E7D32" />
                          <Setter Property="BorderBrush" Value="#2E7D32" />
                          <Setter Property="Content" Value="TURN OUTPUT ON" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Status.OutputEnabled}" Value="True">
                              <Setter Property="Background" Value="#C62828" />
                              <Setter Property="BorderBrush" Value="#C62828" />
                              <Setter Property="Content" Value="TURN OUTPUT OFF" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>

                    <!--  Set-points  -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="SET-POINTS" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock
                        Grid.Row="0"
                        Width="62"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource VoltageBrush}"
                        Text="Voltage" />
                      <xceed:DoubleUpDown
                        Grid.Row="0"
                        Grid.Column="1"
                        AutomationProperties.Name="Voltage set-point"
                        Maximum="{Binding MaxVoltageToSet}"
                        Minimum="{Binding MinVoltageToSet}"
                        Style="{StaticResource SetPointInput}"
                        Value="{Binding VoltageToSet}" />
                      <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Set voltage"
                        Command="{Binding SetVoltageCommand}">
                        <Button.Style>
                          <Style BasedOn="{StaticResource SetButton}" TargetType="Button">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsVoltageValid}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,2,0,10"
                        FontSize="11"
                        Opacity="0.6">
                        <Run Text="{Binding MinVoltageToSet, Mode=OneWay, StringFormat='{}{0:F2}'}" />
                        <Run Text="–" />
                        <Run Text="{Binding MaxVoltageToSet, Mode=OneWay, StringFormat='{}{0:F2} V'}" />
                      </TextBlock>

                      <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource CurrentBrush}"
                        Text="Current" />
                      <xceed:DoubleUpDown
                        Grid.Row="2"
                        Grid.Column="1"
                        AutomationProperties.Name="Current set-point"
                        Maximum="{Binding MaxCurrentToSet}"
                        Minimum="{Binding MinCurrentToSet}"
                        Style="{StaticResource SetPointInput}"
                        Value="{Binding CurrentToSet}" />
                      <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Set current"
                        Command="{Binding SetCurrentCommand}">
                        <Button.Style>
                          <Style BasedOn="{StaticResource SetButton}" TargetType="Button">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCurrentValid}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,2,0,0"
                        FontSize="11"
                        Opacity="0.6">
                        <Run Text="{Binding MinCurrentToSet, Mode=OneWay, StringFormat='{}{0:F2}'}" />
                        <Run Text="–" />
                        <Run Text="{Binding MaxCurrentToSet, Mode=OneWay, StringFormat='{}{0:F2} A'}" />
                      </TextBlock>
                    </Grid>

                    <!--  Protection  -->
                    <TextBlock Style="{StaticResource SectionTitle}" Text="PROTECTION" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                      </Grid.RowDefinitions>

                      <TextBlock
                        Grid.Row="0"
                        Width="62"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="OVP" />
                      <xceed:DoubleUpDown
                        Grid.Row="0"
                        Grid.Column="1"
                        AutomationProperties.Name="OVP level"
                        Maximum="{Binding MaxOvpToSet}"
                        Minimum="{Binding MinOvpToSet}"
                        Style="{StaticResource SetPointInput}"
                        Value="{Binding OvpToSet}" />
                      <Button
                        Grid.Row="0"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Set OVP"
                        Command="{Binding SetOvpCommand}">
                        <Button.Style>
                          <Style BasedOn="{StaticResource SetButton}" TargetType="Button">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsOvpValid}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,2,0,10"
                        FontSize="11"
                        Opacity="0.6">
                        <Run Text="{Binding MinOvpToSet, Mode=OneWay, StringFormat='{}{0:F2}'}" />
                        <Run Text="–" />
                        <Run Text="{Binding MaxOvpToSet, Mode=OneWay, StringFormat='{}{0:F2} V'}" />
                      </TextBlock>

                      <TextBlock
                        Grid.Row="2"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="OCP" />
                      <xceed:DoubleUpDown
                        Grid.Row="2"
                        Grid.Column="1"
                        AutomationProperties.Name="OCP level"
                        Maximum="{Binding MaxOcpToSet}"
                        Minimum="{Binding MinOcpToSet}"
                        Style="{StaticResource SetPointInput}"
                        Value="{Binding OcpToSet}" />
                      <Button
                        Grid.Row="2"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        AutomationProperties.Name="Set OCP"
                        Command="{Binding SetOcpCommand}">
                        <Button.Style>
                          <Style BasedOn="{StaticResource SetButton}" TargetType="Button">
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsOcpValid}" Value="False">
                                <Setter Property="IsEnabled" Value="False" />
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                      <TextBlock
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="0,2,0,0"
                        FontSize="11"
                        Opacity="0.6">
                        <Run Text="{Binding MinOcpToSet, Mode=OneWay, StringFormat='{}{0:F2}'}" />
                        <Run Text="–" />
                        <Run Text="{Binding MaxOcpToSet, Mode=OneWay, StringFormat='{}{0:F2} A'}" />
                      </TextBlock>
                    </Grid>

                    <UniformGrid Margin="0,12,0,0" Columns="2">
                      <Button
                        Margin="0,0,4,0"
                        Command="{Binding SendMiscCommand}"
                        CommandParameter="TRIPRST"
                        Content="TRIP RESET"
                        Style="{StaticResource CompactOutlinedButton}"
                        ToolTip="Clear a latched OVP / OCP / sense / fault trip" />
                      <Button
                        Margin="4,0,0,0"
                        Command="{Binding SendMiscCommand}"
                        CommandParameter="LOCAL"
                        Content="LOCAL"
                        Style="{StaticResource CompactOutlinedButton}"
                        ToolTip="Return the supply to front-panel control" />
                    </UniformGrid>

                    <!--  Soft limits and storage (was the Settings tab)  -->
                    <Expander
                      Margin="-14,16,-14,0"
                      Padding="14,0,14,8"
                      Background="Transparent"
                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="14,8"
                      AutomationProperties.Name="Soft limits and storage">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="ShieldEditOutline"
                            Opacity="0.8" />
                          <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Soft limits &amp; storage" />
                        </StackPanel>
                      </Expander.Header>
                      <StackPanel>
                        <TextBlock
                          Margin="0,0,0,8"
                          FontSize="11"
                          Opacity="0.7"
                          Text="The voltage and current set-points can only be sent inside these limits."
                          TextWrapping="Wrap" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Column="1" FontSize="11" Opacity="0.7" Text="Min" />
                          <TextBlock Grid.Column="3" FontSize="11" Opacity="0.7" Text="Max" />

                          <TextBlock
                            Grid.Row="1"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource VoltageBrush}"
                            Text="Voltage (V)" />
                          <xceed:DoubleUpDown
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="28"
                            Margin="0,2"
                            AutomationProperties.Name="Minimum voltage"
                            FormatString="F2"
                            Maximum="{Binding InstrumentMaxVoltage}"
                            Minimum="0"
                            Value="{Binding LimitMinVoltage}" />
                          <xceed:DoubleUpDown
                            Grid.Row="1"
                            Grid.Column="3"
                            Height="28"
                            Margin="0,2"
                            AutomationProperties.Name="Maximum voltage"
                            FormatString="F2"
                            Maximum="{Binding InstrumentMaxVoltage}"
                            Minimum="0"
                            Value="{Binding LimitMaxVoltage}" />

                          <TextBlock
                            Grid.Row="2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource CurrentBrush}"
                            Text="Current (A)" />
                          <xceed:DoubleUpDown
                            Grid.Row="2"
                            Grid.Column="1"
                            Height="28"
                            Margin="0,2"
                            AutomationProperties.Name="Minimum current"
                            FormatString="F2"
                            Maximum="{Binding InstrumentMaxCurrent}"
                            Minimum="0"
                            Value="{Binding LimitMinCurrent}" />
                          <xceed:DoubleUpDown
                            Grid.Row="2"
                            Grid.Column="3"
                            Height="28"
                            Margin="0,2"
                            AutomationProperties.Name="Maximum current"
                            FormatString="F2"
                            Maximum="{Binding InstrumentMaxCurrent}"
                            Minimum="0"
                            Value="{Binding LimitMaxCurrent}" />
                        </Grid>

                        <DockPanel Margin="0,12,0,0">
                          <xceed:IntegerUpDown
                            Width="80"
                            Height="28"
                            AutomationProperties.Name="Days to keep"
                            DockPanel.Dock="Right"
                            Maximum="3650"
                            Minimum="0"
                            Value="{Binding LimitRetentionDays}" />
                          <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="Keep logged data (days)" />
                            <TextBlock
                              FontSize="11"
                              Opacity="0.7"
                              Text="0 keeps everything. Older data is deleted permanently."
                              TextWrapping="Wrap" />
                          </StackPanel>
                        </DockPanel>

                        <CheckBox
                          Margin="0,12,0,0"
                          AutomationProperties.Name="Ask before turning the output ON"
                          Content="Ask before turning the output ON"
                          IsChecked="{Binding ConfirmOutputOn}"
                          ToolTip="Saved immediately" />

                        <DockPanel Margin="0,12,0,0">
                          <Button
                            Command="{Binding SaveLimitsCommand}"
                            Content="SAVE"
                            DockPanel.Dock="Right"
                            Style="{StaticResource CompactRaisedButton}" />
                          <Button
                            Margin="0,0,8,0"
                            Command="{Binding RevertLimitsCommand}"
                            Content="REVERT"
                            DockPanel.Dock="Right"
                            Style="{StaticResource CompactOutlinedButton}"
                            ToolTip="Discard unsaved changes" />
                          <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource OkBrush}"
                            Text="{Binding LimitsStatusText}" />
                        </DockPanel>
                      </StackPanel>
                    </Expander>

                    <!--  Alarms  -->
                    <Expander
                      Margin="-14,0,-14,0"
                      Padding="14,0,14,8"
                      Background="Transparent"
                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="14,8"
                      AutomationProperties.Name="Alarms"
                      DataContext="{Binding Alarms, Source={StaticResource Locator}}">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="BellCogOutline"
                            Opacity="0.8" />
                          <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Alarms" />
                        </StackPanel>
                      </Expander.Header>
                      <StackPanel>
                        <TextBlock
                          Margin="0,0,0,8"
                          FontSize="11"
                          Opacity="0.7"
                          Text="Thresholds are checked while the output is ON. Every alarm is written to the command log and shown as a red marker in History."
                          TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Rules}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AlarmRule}">
                              <DockPanel Margin="0,2">
                                <TextBlock
                                  Width="14"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center"
                                  DockPanel.Dock="Right"
                                  Opacity="0.7"
                                  Text="{Binding Unit}" />
                                <xceed:DoubleUpDown
                                  Width="90"
                                  Height="28"
                                  AutomationProperties.Name="{Binding Name}"
                                  DockPanel.Dock="Right"
                                  FormatString="F3"
                                  Increment="0.1"
                                  Minimum="0"
                                  Value="{Binding Limit}" />
                                <CheckBox
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Name}"
                                  Content="{Binding Name}"
                                  IsChecked="{Binding IsEnabled}" />
                              </DockPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,8,0,0">
                          <xceed:IntegerUpDown
                            Width="70"
                            Height="28"
                            AutomationProperties.Name="Alarm delay"
                            DockPanel.Dock="Right"
                            Maximum="3600"
                            Minimum="0"
                            Value="{Binding DelaySeconds}" />
                          <TextBlock
                            VerticalAlignment="Center"
                            Text="Raise after (s)"
                            ToolTip="A threshold must be exceeded this long before the alarm is raised" />
                        </DockPanel>
                        <CheckBox
                          Margin="0,8,0,0"
                          Content="Alarm on protection trips"
                          IsChecked="{Binding AlarmOnTrip}" />
                        <CheckBox
                          Margin="0,4,0,0"
                          Content="Alarm when the link is lost"
                          IsChecked="{Binding AlarmOnLinkLost}" />
                        <CheckBox
                          Margin="0,4,0,0"
                          Content="Play a sound"
                          IsChecked="{Binding PlaySound}" />
                        <CheckBox
                          Margin="0,4,0,0"
                          Content="Turn the output OFF on a threshold alarm"
                          IsChecked="{Binding TurnOutputOff}"
                          ToolTip="Software protection: the output is switched off when a threshold alarm is raised" />
                      </StackPanel>
                    </Expander>
                  </StackPanel>
                </ScrollViewer>
              </materialDesign:Card>
            </Grid>
          </Grid>
        </TabItem>

        <TabItem AutomationProperties.Name="Sequencer">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="PlaylistPlay" />
              <TextBlock VerticalAlignment="Center" Text="Sequencer" />
            </StackPanel>
          </TabItem.Header>
          <View:SequencerView />
        </TabItem>
        <TabItem AutomationProperties.Name="History">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="ChartTimelineVariant" />
              <TextBlock VerticalAlignment="Center" Text="History" />
            </StackPanel>
          </TabItem.Header>
          <View:HistoryView />
        </TabItem>
        <TabItem AutomationProperties.Name="Data Logs">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="DatabaseSearchOutline" />
              <TextBlock VerticalAlignment="Center" Text="Data Logs" />
            </StackPanel>
          </TabItem.Header>
          <View:DataRetrievalView />
        </TabItem>
        <TabItem AutomationProperties.Name="SCPI Console">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="Console" />
              <TextBlock VerticalAlignment="Center" Text="SCPI Console" />
            </StackPanel>
          </TabItem.Header>
          <View:ScpiConsoleView />
        </TabItem>
        <TabItem AutomationProperties.Name="App Logs">
          <TabItem.Header>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="TextBoxOutline" />
              <TextBlock VerticalAlignment="Center" Text="App Logs" />
            </StackPanel>
          </TabItem.Header>
          <View:AppLogsView />
        </TabItem>
      </TabControl>
    </DockPanel>
  </materialDesign:DialogHost>
</Window>
