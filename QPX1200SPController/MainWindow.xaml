<Window
  x:Class="QPX1200SPController.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:View="clr-namespace:QPX1200SPController.Views"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
  xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
  Title="QPX1200SP Power Supply Controller"
  Width="1280"
  Height="800"
  MinWidth="960"
  MinHeight="640"
  Background="{DynamicResource MaterialDesignPaper}"
  DataContext="{Binding Main, Source={StaticResource Locator}}"
  FontFamily="{materialDesign:MaterialDesignFont}"
  Loaded="MainWindow_OnLoaded"
  Style="{StaticResource MaterialDesignWindow}"
  TextElement.Foreground="{DynamicResource MaterialDesignBody}"
  WindowStartupLocation="CenterScreen"
  mc:Ignorable="d">

  <Window.Resources>
    <Style
      x:Key="CompactRaisedButton"
      BasedOn="{StaticResource MaterialDesignRaisedButton}"
      TargetType="Button">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style
      x:Key="CompactOutlinedButton"
      BasedOn="{StaticResource MaterialDesignOutlinedButton}"
      TargetType="Button">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style
      x:Key="CompactTextBox"
      BasedOn="{StaticResource MaterialDesignTextBox}"
      TargetType="TextBox">
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="Height" Value="28" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FontSize" Value="13" />
    </Style>
    <Style
      x:Key="CompactTabItem"
      BasedOn="{StaticResource MaterialDesignTabItem}"
      TargetType="TabItem">
      <Setter Property="Padding" Value="14,4" />
      <Setter Property="MinHeight" Value="28" />
      <Setter Property="FontSize" Value="13" />
    </Style>
  </Window.Resources>

  <materialDesign:DialogHost Identifier="RootDialog">
    <DockPanel>
      <materialDesign:ColorZone
        Padding="8,4"
        materialDesign:ElevationAssist.Elevation="Dp2"
        DockPanel.Dock="Top"
        Mode="PrimaryMid">
        <DockPanel>
          <StackPanel
            VerticalAlignment="Center"
            DockPanel.Dock="Left"
            Orientation="Horizontal">
            <materialDesign:PackIcon
              Width="20"
              Height="20"
              VerticalAlignment="Center"
              Kind="Flash" />
            <TextBlock
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              FontSize="14"
              FontWeight="SemiBold"
              Text="QPX1200SP" />
            <TextBlock
              Margin="8,0,0,0"
              VerticalAlignment="Center"
              FontSize="12"
              Opacity="0.85"
              Text="Monitoring &amp; Control" />
          </StackPanel>
          <TextBlock
            Margin="12,0,0,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Right"
            FontSize="12"
            FontWeight="SemiBold"
            Text="{Binding ConnectionStatus}">
            <TextBlock.Style>
              <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                <Setter Property="Foreground" Value="#FFCDD2" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter Property="Foreground" Value="#C8E6C9" />
                  </DataTrigger>
                  <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                    <Setter Property="Foreground" Value="#FFE082" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </DockPanel>
      </materialDesign:ColorZone>

      <TabControl
        Padding="0"
        ItemContainerStyle="{StaticResource CompactTabItem}"
        materialDesign:ColorZoneAssist.Mode="Standard"
        Style="{StaticResource MaterialDesignTabControl}">
        <TabItem Header="Monitoring &amp; Control">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Connection bar  -->
            <materialDesign:Card
              Grid.Row="0"
              Margin="8,6,8,4"
              Padding="8,4"
              materialDesign:ElevationAssist.Elevation="Dp2">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="180" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                  Grid.Column="0"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  FontSize="12"
                  FontWeight="SemiBold"
                  Text="IP Address" />
                <TextBox
                  Grid.Column="1"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Style="{StaticResource CompactTextBox}"
                  Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                  Grid.Column="2"
                  Margin="0,0,6,0"
                  Command="{Binding ConnectCommand}"
                  Content="CONNECT"
                  IsEnabled="{Binding IsConnected, Converter={StaticResource InverseBoolConverter}}"
                  Style="{StaticResource CompactRaisedButton}" />
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                  <Button
                    Margin="0,0,12,0"
                    Command="{Binding DisconnectCommand}"
                    Content="DISCONNECT"
                    Style="{StaticResource CompactOutlinedButton}" />
                  <TextBlock
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Sample rate" />
                  <ComboBox
                    Width="80"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    DisplayMemberPath="DisplayName"
                    FontSize="12"
                    ItemsSource="{Binding SampleRates}"
                    SelectedItem="{Binding SelectedSampleRate}"
                    Style="{StaticResource MaterialDesignComboBox}"
                    ToolTip="How often the supply is read and logged to the database" />
                </StackPanel>
                <StackPanel Grid.Column="6" Orientation="Horizontal">
                  <TextBlock
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Text="OUTPUT:" />
                  <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontWeight="Bold"
                    Foreground="{Binding Status.OutputEnabled, Converter={StaticResource OutputEnabledToForegroundConverter}}"
                    Text="{Binding Status.OutputEnabled, Converter={StaticResource BoolToOnOffConverter}}" />
                </StackPanel>

                <TextBlock
                  Grid.Column="5"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  FontSize="12"
                  Opacity="0.8"
                  Text="{Binding SupplyName, TargetNullValue='---'}"
                  TextTrimming="CharacterEllipsis"
                  ToolTip="{Binding SupplyName}" />
                <Button
                  Grid.Column="4"
                  Margin="0,0,8,0"
                  HorizontalAlignment="Right"
                  Command="{Binding ToggleControlPanelCommand}"
                  Style="{StaticResource CompactOutlinedButton}"
                  ToolTip="{Binding ControlPanelToggleText}">
                  <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                      Width="16"
                      Height="16"
                      Margin="0,0,4,0"
                      VerticalAlignment="Center"
                      Kind="ViewDashboardOutline" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Text="{Binding ControlPanelToggleText}" />
                  </StackPanel>
                </Button>
              </Grid>
            </materialDesign:Card>

            <!--  Main: Digital | Graphs | Control  -->
            <Grid
              x:Name="MainContentGrid"
              Grid.Row="1"
              Margin="8,0,8,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition
                  x:Name="DigitalColumn"
                  Width="*"
                  MinWidth="150" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition
                  x:Name="GraphColumn"
                  Width="*"
                  MinWidth="200" />
                <ColumnDefinition x:Name="ControlSplitterColumn" Width="6" />
                <ColumnDefinition
                  x:Name="ControlColumn"
                  Width="300"
                  MinWidth="180" />
              </Grid.ColumnDefinitions>

              <!--  Digital values  -->
              <materialDesign:Card
                Grid.Column="0"
                Margin="4"
                Padding="12"
                materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>
                  <TextBlock
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SecondaryHueMidBrush}"
                    Text="{Binding Status.Time, TargetNullValue='---'}" />
                  <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="2*" />
                      <RowDefinition Height="2*" />
                      <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                      Grid.Row="0"
                      Margin="4"
                      Padding="8"
                      Background="{Binding Status.OutputEnabled, Converter={StaticResource OutputEnabledToBrushConverter}}"
                      CornerRadius="8">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                          Grid.Row="0"
                          HorizontalAlignment="Center"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Opacity="0.75"
                          Text="VOLTAGE (V)" />
                        <TextBlock
                          Grid.Row="1"
                          Margin="8,0,8,4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          Panel.ZIndex="1"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Text="{Binding PowerSupplySettingStatus.SetVoltage, StringFormat='Set: {0:F2}V', TargetNullValue='---'}" />
                        <TextBlock
                          Grid.Row="1"
                          Margin="0,0,8,4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Panel.ZIndex="1"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Text="{Binding PowerSupplySettingStatus.SetOvpLevel, StringFormat='OVP: {0:F2}V', TargetNullValue='---'}" />
                        <Viewbox Grid.Row="1" Stretch="Uniform">
                          <TextBlock
                            FontSize="120"
                            FontWeight="Bold"
                            Text="{Binding Status.Voltage, StringFormat='{}{0:F3}'}" />
                        </Viewbox>
                      </Grid>
                    </Border>

                    <Border
                      Grid.Row="1"
                      Margin="4"
                      Padding="8"
                      Background="{Binding Status.OutputEnabled, Converter={StaticResource OutputEnabledToBrushConverter}}"
                      CornerRadius="8">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                          Grid.Row="0"
                          HorizontalAlignment="Center"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Opacity="0.75"
                          Text="CURRENT (A)" />
                        <TextBlock
                          Grid.Row="1"
                          Margin="8,0,8,4"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Bottom"
                          Panel.ZIndex="1"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Text="{Binding PowerSupplySettingStatus.SetCurrent, StringFormat='Set: {0:F2}A', TargetNullValue='---'}" />
                        <TextBlock
                          Grid.Row="1"
                          Margin="0,0,8,4"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Panel.ZIndex="1"
                          FontSize="12"
                          FontWeight="SemiBold"
                          Text="{Binding PowerSupplySettingStatus.SetOcpLevel, StringFormat='OCP: {0:F2}A', TargetNullValue='---'}" />
                        <Viewbox Grid.Row="1" Stretch="Uniform">
                          <TextBlock
                            FontSize="120"
                            FontWeight="Bold"
                            Text="{Binding Status.Current, StringFormat={}{0:F3}}" />
                        </Viewbox>
                      </Grid>
                    </Border>

                    <Border
                      Grid.Row="2"
                      Margin="4"
                      Padding="8"
                      Background="{Binding Status.OutputEnabled, Converter={StaticResource OutputEnabledToBrushConverter}}"
                      CornerRadius="8">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                          Grid.Row="0"
                          HorizontalAlignment="Center"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Opacity="0.75"
                          Text="POWER (W)" />
                        <Viewbox Grid.Row="1" Stretch="Uniform">
                          <TextBlock
                            FontSize="120"
                            FontWeight="Bold"
                            Text="{Binding Status.Power, StringFormat={}{0:F2}}" />
                        </Viewbox>
                      </Grid>
                    </Border>
                  </Grid>
                </Grid>
              </materialDesign:Card>

              <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource MaterialDesignDivider}"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True" />

              <!--  Live graphs  -->
              <materialDesign:Card
                Grid.Column="2"
                Margin="4"
                Padding="12"
                materialDesign:ElevationAssist.Elevation="Dp2">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="*" />
                  </Grid.RowDefinitions>

                  <DockPanel
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    LastChildFill="False">
                    <materialDesign:PackIcon
                      Width="20"
                      Height="20"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      Kind="ChartLine" />
                    <TextBlock
                      VerticalAlignment="Center"
                      Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                      Text="Time Window: " />
                    <ComboBox
                      Width="150"
                      Margin="16,0,0,0"
                      VerticalAlignment="Center"
                      DisplayMemberPath="DisplayName"
                      ItemsSource="{Binding GraphTimeWindows}"
                      SelectedItem="{Binding SelectedGraphTimeWindow}"
                      Style="{StaticResource MaterialDesignComboBox}" />
                  </DockPanel>

                  <Border
                    Grid.Row="1"
                    Margin="0,2"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    CornerRadius="4">
                    <Grid>
                      <scottPlot:WpfPlot x:Name="VoltagePlot" />
                      <Border
                        Margin="0,6,8,0"
                        Padding="6,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1"
                        Background="#F2FFFFFF"
                        BorderBrush="#33000000"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.75"
                            Text="Y:" />
                          <ComboBox
                            Width="86"
                            VerticalAlignment="Center"
                            FontSize="12"
                            ItemsSource="{Binding YAxisScaleModes}"
                            SelectedItem="{Binding VoltageYAxis.Mode}"
                            Style="{StaticResource MaterialDesignComboBox}" />
                          <StackPanel
                            Margin="6,0,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding VoltageYAxis.IsManual, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                              Margin="0,0,4,0"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Opacity="0.75"
                              Text="Lower" />
                            <xceed:DoubleUpDown
                              Width="70"
                              VerticalAlignment="Center"
                              FontSize="12"
                              FormatString="F2"
                              Increment="0.1"
                              ToolTip="Y-axis lower value"
                              Value="{Binding VoltageYAxis.YMin, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                              Margin="6,0,4,0"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Opacity="0.75"
                              Text="Upper" />
                            <xceed:DoubleUpDown
                              Width="70"
                              VerticalAlignment="Center"
                              FontSize="12"
                              FormatString="F2"
                              Increment="0.1"
                              ToolTip="Y-axis upper value"
                              Value="{Binding VoltageYAxis.YMax, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                  <Border
                    Grid.Row="2"
                    Margin="0,2"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    CornerRadius="4">
                    <Grid>
                      <scottPlot:WpfPlot x:Name="CurrentPlot" />
                      <Border
                        Margin="0,6,8,0"
                        Padding="6,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1"
                        Background="#F2FFFFFF"
                        BorderBrush="#33000000"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.75"
                            Text="Y:" />
                          <ComboBox
                            Width="86"
                            VerticalAlignment="Center"
                            FontSize="12"
                            ItemsSource="{Binding YAxisScaleModes}"
                            SelectedItem="{Binding CurrentYAxis.Mode}"
                            Style="{StaticResource MaterialDesignComboBox}" />
                          <StackPanel
                            Margin="6,0,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding CurrentYAxis.IsManual, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                              Margin="0,0,4,0"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Opacity="0.75"
                              Text="Lower" />
                            <xceed:DoubleUpDown
                              Width="70"
                              VerticalAlignment="Center"
                              FontSize="12"
                              FormatString="F2"
                              Increment="0.1"
                              ToolTip="Y-axis lower value"
                              Value="{Binding CurrentYAxis.YMin, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                              Margin="6,0,4,0"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Opacity="0.75"
                              Text="Upper" />
                            <xceed:DoubleUpDown
                              Width="70"
                              VerticalAlignment="Center"
                              FontSize="12"
                              FormatString="F2"
                              Increment="0.1"
                              ToolTip="Y-axis upper value"
                              Value="{Binding CurrentYAxis.YMax, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                  <Border
                    Grid.Row="3"
                    Margin="0,2"
                    Background="{DynamicResource MaterialDesignCardBackground}"
                    CornerRadius="4">
                    <Grid>
                      <scottPlot:WpfPlot x:Name="PowerPlot" />
                      <Border
                        Margin="0,6,8,0"
                        Padding="6,2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Panel.ZIndex="1"
                        Background="#F2FFFFFF"
                        BorderBrush="#33000000"
                        BorderThickness="1"
                        CornerRadius="4">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Opacity="0.75"
                            Text="Y:" />
                          <ComboBox
                            Width="86"
                            VerticalAlignment="Center"
                            FontSize="12"
                            ItemsSource="{Binding YAxisScaleModes}"
                            SelectedItem="{Binding PowerYAxis.Mode}"
                            Style="{StaticResource MaterialDesignComboBox}" />
                          <StackPanel
                            Margin="6,0,0,0"
                            Orientation="Horizontal"
                            Visibility="{Binding PowerYAxis.IsManual, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock
                              Margin="0,0,4,0"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Opacity="0.75"
                              Text="Lower" />
                            <xceed:DoubleUpDown
                              Width="70"
                              VerticalAlignment="Center"
                              FontSize="12"
                              FormatString="F2"
                              Increment="1"
                              ToolTip="Y-axis lower value"
                              Value="{Binding PowerYAxis.YMin, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                              Margin="6,0,4,0"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Opacity="0.75"
                              Text="Upper" />
                            <xceed:DoubleUpDown
                              Width="70"
                              VerticalAlignment="Center"
                              FontSize="12"
                              FormatString="F2"
                              Increment="1"
                              ToolTip="Y-axis upper value"
                              Value="{Binding PowerYAxis.YMax, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Border>
                </Grid>
              </materialDesign:Card>

              <GridSplitter
                x:Name="ControlSplitter"
                Grid.Column="3"
                Width="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="{DynamicResource MaterialDesignDivider}"
                ResizeBehavior="PreviousAndNext"
                ShowsPreview="True" />

              <!--  Control panel (visibility driven by code-behind with column widths)  -->
              <materialDesign:Card
                x:Name="ControlPanelBorder"
                Grid.Column="4"
                Margin="4"
                Padding="12"
                materialDesign:ElevationAssist.Elevation="Dp2">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <TextBlock
                      Margin="0,0,0,12"
                      HorizontalAlignment="Center"
                      Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                      Text="CONTROL PANEL" />

                    <materialDesign:Card
                      Margin="0,0,0,10"
                      Padding="10"
                      UniformCornerRadius="6">
                      <StackPanel>
                        <TextBlock
                          Margin="0,0,0,8"
                          Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                          Text="Voltage Control" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <xceed:DoubleUpDown
                            FontSize="16"
                            Increment="0.1"
                            Maximum="{Binding MaxVoltageToSet}"
                            Minimum="{Binding MinVoltageToSet}"
                            TextAlignment="Right"
                            Value="{Binding VoltageToSet}" />
                          <TextBlock
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Text="V" />
                          <Button
                            Grid.Column="2"
                            Command="{Binding SetVoltageCommand}"
                            Content="SET">
                            <Button.Style>
                              <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsVoltageValid}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </Grid>
                      </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card
                      Margin="0,0,0,10"
                      Padding="10"
                      UniformCornerRadius="6">
                      <StackPanel>
                        <TextBlock
                          Margin="0,0,0,8"
                          Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                          Text="Current Control" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <xceed:DoubleUpDown
                            FontSize="16"
                            Increment="0.1"
                            Maximum="{Binding MaxCurrentToSet}"
                            Minimum="{Binding MinCurrentToSet}"
                            TextAlignment="Right"
                            Value="{Binding CurrentToSet}" />
                          <TextBlock
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Text="A" />
                          <Button
                            Grid.Column="2"
                            Command="{Binding SetCurrentCommand}"
                            Content="SET">
                            <Button.Style>
                              <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsCurrentValid}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </Grid>
                      </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card
                      Margin="0,0,0,10"
                      Padding="10"
                      UniformCornerRadius="6">
                      <StackPanel>
                        <TextBlock
                          Margin="0,0,0,8"
                          Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                          Text="Over Voltage Protection" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <xceed:DoubleUpDown
                            FontSize="16"
                            Increment="0.1"
                            Maximum="{Binding MaxOvpToSet}"
                            Minimum="{Binding MinOvpToSet}"
                            TextAlignment="Right"
                            Value="{Binding OvpToSet}" />
                          <TextBlock
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Text="V" />
                          <Button
                            Grid.Column="2"
                            Command="{Binding SetOvpCommand}"
                            Content="SET">
                            <Button.Style>
                              <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsOvpValid}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </Grid>
                      </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card
                      Margin="0,0,0,10"
                      Padding="10"
                      UniformCornerRadius="6">
                      <StackPanel>
                        <TextBlock
                          Margin="0,0,0,8"
                          Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                          Text="Over Current Protection" />
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>
                          <xceed:DoubleUpDown
                            FontSize="16"
                            Increment="0.1"
                            Maximum="{Binding MaxOcpToSet}"
                            Minimum="{Binding MinOcpToSet}"
                            TextAlignment="Right"
                            Value="{Binding OcpToSet}" />
                          <TextBlock
                            Grid.Column="1"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Text="A" />
                          <Button
                            Grid.Column="2"
                            Command="{Binding SetOcpCommand}"
                            Content="SET">
                            <Button.Style>
                              <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsOcpValid}" Value="False">
                                    <Setter Property="IsEnabled" Value="False" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Button.Style>
                          </Button>
                        </Grid>
                      </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card
                      Margin="0,0,0,10"
                      Padding="10"
                      UniformCornerRadius="6">
                      <StackPanel>
                        <TextBlock
                          Margin="0,0,0,8"
                          Style="{StaticResource MaterialDesignSubtitle2TextBlock}"
                          Text="Misc Control" />
                        <UniformGrid Columns="2">
                          <Button
                            Margin="0,0,4,0"
                            Command="{Binding SendMiscCommand}"
                            CommandParameter="TRIPRST"
                            Content="TRIP Reset"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                          <Button
                            Margin="4,0,0,0"
                            Command="{Binding SendMiscCommand}"
                            CommandParameter="LOCAL"
                            Content="LOCAL"
                            Style="{StaticResource MaterialDesignOutlinedButton}" />
                        </UniformGrid>
                      </StackPanel>
                    </materialDesign:Card>

                    <materialDesign:Card
                      Margin="0,0,0,12"
                      Padding="12"
                      Background="{DynamicResource SecondaryHueLightBrush}"
                      UniformCornerRadius="6">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                          Grid.Column="0"
                          MinWidth="110"
                          Background="{Binding Status.OutputEnabled, Converter={StaticResource OutputButtonBackgroundConverter}}"
                          Command="{Binding ToggleOutputCommand}"
                          Content="{Binding Status.OutputEnabled, Converter={StaticResource OutputButtonTextConverter}}"
                          FontWeight="Bold"
                          Foreground="White"
                          Style="{StaticResource MaterialDesignRaisedButton}" />
                      </Grid>
                    </materialDesign:Card>

                    <CheckBox
                      Content="Enable Configuration"
                      IsChecked="{Binding IsInConfigMode}"
                      Style="{StaticResource MaterialDesignCheckBox}" />
                  </StackPanel>
                </ScrollViewer>
              </materialDesign:Card>
            </Grid>

            <!--  Event status bar (bottom)  -->
            <materialDesign:ColorZone
              Grid.Row="2"
              Padding="16,10"
              Mode="Standard">
              <DockPanel>
                <TextBlock
                  Margin="0,0,16,0"
                  VerticalAlignment="Center"
                  FontWeight="SemiBold"
                  Text="Event Status" />
                <UniformGrid Columns="6">
                  <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                      Width="12"
                      Height="12"
                      Margin="0,0,6,0"
                      Fill="{Binding EventStatus.ConstantVoltageMode, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                    <TextBlock VerticalAlignment="Center" Text="CV" />
                  </StackPanel>
                  <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                      Width="12"
                      Height="12"
                      Margin="0,0,6,0"
                      Fill="{Binding EventStatus.ConstantCurrentMode, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                    <TextBlock VerticalAlignment="Center" Text="CC" />
                  </StackPanel>
                  <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                      Width="12"
                      Height="12"
                      Margin="0,0,6,0"
                      Fill="{Binding EventStatus.UnregulatedMode, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                    <TextBlock VerticalAlignment="Center" Text="Unreg" />
                  </StackPanel>
                  <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                      Width="12"
                      Height="12"
                      Margin="0,0,6,0"
                      Fill="{Binding EventStatus.OverVoltageTrip, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                    <TextBlock VerticalAlignment="Center" Text="OVP" />
                  </StackPanel>
                  <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                      Width="12"
                      Height="12"
                      Margin="0,0,6,0"
                      Fill="{Binding EventStatus.OverCurrentTrip, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                    <TextBlock VerticalAlignment="Center" Text="OCP" />
                  </StackPanel>
                  <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                    <Ellipse
                      Width="12"
                      Height="12"
                      Margin="0,0,6,0"
                      Fill="{Binding EventStatus.FaultTrip, Converter={StaticResource BoolToProtectionBrushConverter}}" />
                    <TextBlock VerticalAlignment="Center" Text="Fault" />
                  </StackPanel>
                </UniformGrid>
              </DockPanel>
            </materialDesign:ColorZone>
          </Grid>
        </TabItem>

        <TabItem Header="Settings">
          <View:Settings />
        </TabItem>
        <TabItem Header="Data Logs">
          <View:DataRetrievalView />
        </TabItem>
        <TabItem Header="App Logs">
          <View:AppLogsView />
        </TabItem>
      </TabControl>
    </DockPanel>
  </materialDesign:DialogHost>
</Window>
