<Window
  x:Class="QPX1200SPController.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:View="clr-namespace:QPX1200SPController.Views"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:scottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
  xmlns:vm="clr-namespace:QPX1200SPController.ViewModels"
  xmlns:xceed="http://schemas.xceed.com/wpf/xaml/toolkit"
  Title="QPX1200SP Power Supply Controller"
  Width="1360"
  Height="860"
  MinWidth="1180"
  MinHeight="700"
  Background="{DynamicResource MaterialDesign.Brush.Background}"
  DataContext="{Binding Main, Source={StaticResource Locator}}"
  FontFamily="{materialDesign:MaterialDesignFont}"
  Loaded="MainWindow_OnLoaded"
  Style="{StaticResource MaterialDesignWindow}"
  TextElement.Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
  WindowStartupLocation="CenterScreen"
  WindowState="Maximized"
  mc:Ignorable="d">
  <!--  Width/Height are the size when the window is restored from maximized  -->

  <Window.Resources>
    <Style
      x:Key="CompactRaisedButton"
      BasedOn="{StaticResource MaterialDesignRaisedButton}"
      TargetType="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style
      x:Key="CompactOutlinedButton"
      BasedOn="{StaticResource MaterialDesignOutlinedButton}"
      TargetType="Button">
      <Setter Property="MinHeight" Value="30" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!--  Page buttons in the header bar (instead of a separate tab strip, to leave room for meters and plots)  -->
    <Style
      x:Key="HeaderTab"
      BasedOn="{StaticResource MaterialDesignTabRadioButton}"
      TargetType="RadioButton">
      <Setter Property="Height" Value="36" />
      <Setter Property="Margin" Value="1,0" />
      <Setter Property="Padding" Value="12,0" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="White" />
    </Style>

    <!--  Small rounded label used for the header chips and the status-register indicators  -->
    <Style x:Key="ChipBorder" TargetType="Border">
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Opacity" Value="0.7" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>

    <Style x:Key="RangeHint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="10.5" />
      <Setter Property="Opacity" Value="0.6" />
      <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style x:Key="SetButton" BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinWidth" Value="56" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Content" Value="SET" />
    </Style>

    <Style x:Key="SetPointInput" TargetType="xceed:DoubleUpDown" BasedOn="{StaticResource {x:Type xceed:DoubleUpDown}}">
      <Setter Property="Height" Value="28" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FormatString" Value="F3" />
      <Setter Property="Increment" Value="0.1" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!--  Y-axis mode in the top left corner of each live plot, just right of the Y axis, so it never covers the newest samples at the right edge  -->
    <Style x:Key="PlotOverlay" TargetType="Border">
      <Setter Property="Margin" Value="84,4,0,0" />
      <Setter Property="Padding" Value="6,2" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Top" />
      <Setter Property="Panel.ZIndex" Value="1" />
      <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource OverlayBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>

    <DataTemplate x:Key="YAxisOverlayTemplate" DataType="{x:Type vm:PlotYAxisSettings}">
      <StackPanel Orientation="Horizontal">
        <TextBlock
          Margin="0,0,6,0"
          VerticalAlignment="Center"
          FontSize="11"
          Opacity="0.75"
          Text="Y" />
        <ComboBox
          Width="78"
          VerticalAlignment="Center"
          FontSize="12"
          ItemsSource="{Binding DataContext.YAxisScaleModes, RelativeSource={RelativeSource AncestorType=Window}}"
          SelectedItem="{Binding Mode}"
          Style="{StaticResource MaterialDesignComboBox}" />
        <StackPanel
          Margin="6,0,0,0"
          Orientation="Horizontal"
          Visibility="{Binding IsManual, Converter={StaticResource BoolToVisibilityConverter}}">
          <xceed:DoubleUpDown
            Width="70"
            VerticalAlignment="Center"
            FontSize="12"
            FormatString="F2"
            Increment="0.1"
            ToolTip="Y-axis lower value"
            Value="{Binding YMin, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock
            Margin="4,0"
            VerticalAlignment="Center"
            Opacity="0.75"
            Text="–" />
          <xceed:DoubleUpDown
            Width="70"
            VerticalAlignment="Center"
            FontSize="12"
            FormatString="F2"
            Increment="0.1"
            ToolTip="Y-axis upper value"
            Value="{Binding YMax, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </Window.Resources>

  <materialDesign:DialogHost Identifier="RootDialog">
    <DockPanel>

      <!--  ===== Header: title, page buttons, theme, output and connection chips =====  -->
      <Border
        Padding="12,2"
        Background="{DynamicResource HeaderBrush}"
        DockPanel.Dock="Top"
        TextElement.Foreground="White">
        <DockPanel>
          <Border
            Width="28"
            Height="28"
            Background="#33FFFFFF"
            CornerRadius="14"
            DockPanel.Dock="Left">
            <materialDesign:PackIcon
              Width="18"
              Height="18"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Foreground="#FFD54F"
              Kind="Flash" />
          </Border>
          <StackPanel
            MaxWidth="230"
            Margin="10,0,0,0"
            VerticalAlignment="Center"
            DockPanel.Dock="Left">
            <TextBlock
              FontSize="14"
              FontWeight="SemiBold"
              Text="QPX1200SP" />
            <TextBlock
              FontSize="10"
              Opacity="0.8"
              Text="{Binding SupplyName, TargetNullValue='No supply connected', FallbackValue='No supply connected'}"
              TextTrimming="CharacterEllipsis">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SupplyName}" Value="">
                      <Setter Property="Text" Value="No supply connected" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>

          <StackPanel
            Margin="20,0,0,0"
            DockPanel.Dock="Left"
            Orientation="Horizontal">
            <RadioButton
              x:Name="MonitorTab"
              AutomationProperties.Name="Monitoring &amp; Control"
              GroupName="Pages"
              IsChecked="True"
              Style="{StaticResource HeaderTab}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="Gauge" />
                <TextBlock VerticalAlignment="Center" Text="Monitoring &amp; Control" />
              </StackPanel>
            </RadioButton>
            <RadioButton
              x:Name="SequencerTab"
              AutomationProperties.Name="Sequencer"
              GroupName="Pages"
              Style="{StaticResource HeaderTab}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="PlaylistPlay" />
                <TextBlock VerticalAlignment="Center" Text="Sequencer" />
              </StackPanel>
            </RadioButton>
            <RadioButton
              x:Name="HistoryTab"
              AutomationProperties.Name="History"
              GroupName="Pages"
              Style="{StaticResource HeaderTab}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="ChartTimelineVariant" />
                <TextBlock VerticalAlignment="Center" Text="History" />
              </StackPanel>
            </RadioButton>
            <RadioButton
              x:Name="DataLogsTab"
              AutomationProperties.Name="Data Logs"
              GroupName="Pages"
              Style="{StaticResource HeaderTab}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="DatabaseSearchOutline" />
                <TextBlock VerticalAlignment="Center" Text="Data Logs" />
              </StackPanel>
            </RadioButton>
            <RadioButton
              x:Name="ConsoleTab"
              AutomationProperties.Name="SCPI Console"
              GroupName="Pages"
              Style="{StaticResource HeaderTab}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="Console" />
                <TextBlock VerticalAlignment="Center" Text="SCPI Console" />
              </StackPanel>
            </RadioButton>
            <RadioButton
              x:Name="AppLogsTab"
              AutomationProperties.Name="App Logs"
              GroupName="Pages"
              Style="{StaticResource HeaderTab}">
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,6,0" VerticalAlignment="Center" Kind="TextBoxOutline" />
                <TextBlock VerticalAlignment="Center" Text="App Logs" />
              </StackPanel>
            </RadioButton>
          </StackPanel>

          <Button
            Width="36"
            Height="36"
            Margin="12,0,0,0"
            Padding="0"
            AutomationProperties.Name="Switch theme"
            Command="{Binding ToggleThemeCommand}"
            DockPanel.Dock="Right"
            Foreground="White"
            Style="{StaticResource MaterialDesignIconButton}"
            ToolTip="Switch between dark and light theme">
            <materialDesign:PackIcon Width="20" Height="20">
              <materialDesign:PackIcon.Style>
                <Style TargetType="materialDesign:PackIcon">
                  <Setter Property="Kind" Value="WeatherSunny" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDarkTheme}" Value="False">
                      <Setter Property="Kind" Value="WeatherNight" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>
          </Button>

          <!--  Output chip  -->
          <Border
            Margin="10,0,0,0"
            AutomationProperties.Name="Output state"
            DockPanel.Dock="Right">
            <Border.Style>
              <Style BasedOn="{StaticResource ChipBorder}" TargetType="Border">
                <Setter Property="Background" Value="#26FFFFFF" />
                <Setter Property="BorderBrush" Value="#66FFFFFF" />
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding IsConnected}" Value="True" />
                      <Condition Binding="{Binding Status.OutputEnabled}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#43A047" />
                    <Setter Property="BorderBrush" Value="#A5D6A7" />
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <materialDesign:PackIcon
                Width="14"
                Height="14"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Kind="Power" />
              <TextBlock FontSize="12" FontWeight="SemiBold">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="OUTPUT ---" />
                    <Style.Triggers>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsConnected}" Value="True" />
                          <Condition Binding="{Binding Status.OutputEnabled}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Text" Value="OUTPUT ON" />
                      </MultiDataTrigger>
                      <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                          <Condition Binding="{Binding IsConnected}" Value="True" />
                          <Condition Binding="{Binding Status.OutputEnabled}" Value="False" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Text" Value="OUTPUT OFF" />
                      </MultiDataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
          </Border>

          <!--  Connection chip  -->
          <Border DockPanel.Dock="Right" AutomationProperties.Name="Connection state">
            <Border.Style>
              <Style BasedOn="{StaticResource ChipBorder}" TargetType="Border">
                <Setter Property="Background" Value="#26FFFFFF" />
                <Setter Property="BorderBrush" Value="#66FFFFFF" />
              </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
              <Ellipse
                Width="9"
                Height="9"
                Margin="0,0,6,0"
                VerticalAlignment="Center">
                <Ellipse.Style>
                  <Style TargetType="Ellipse">
                    <Setter Property="Fill" Value="#EF9A9A" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsConnected}" Value="True">
                        <Setter Property="Fill" Value="#69F0AE" />
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsReconnecting}" Value="True">
                        <Setter Property="Fill" Value="#FFD740" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Ellipse.Style>
              </Ellipse>
              <TextBlock
                FontSize="12"
                FontWeight="SemiBold"
                Text="{Binding ConnectionStatus}" />
            </StackPanel>
          </Border>
          <Grid />
        </DockPanel>
      </Border>

      <!--  ===== Alarm banner (all tabs) =====  -->
      <Border
        Padding="14,6"
        AutomationProperties.Name="Alarm banner"
        Background="{DynamicResource ErrorBrush}"
        DataContext="{Binding Alarms, Source={StaticResource Locator}}"
        DockPanel.Dock="Top"
        TextElement.Foreground="White"
        ToolTip="{Binding BannerToolTip}"
        Visibility="{Binding HasBanner, Converter={StaticResource BoolToVisibilityConverter}}">
        <DockPanel>
          <Button
            Height="28"
            Padding="12,0"
            AutomationProperties.Name="Acknowledge alarms"
            BorderBrush="White"
            Command="{Binding AcknowledgeCommand}"
            Content="ACKNOWLEDGE"
            DockPanel.Dock="Right"
            FontSize="12"
            Foreground="White"
            Style="{StaticResource MaterialDesignOutlinedButton}" />
          <materialDesign:PackIcon
            Width="20"
            Height="20"
            Margin="0,0,10,0"
            VerticalAlignment="Center"
            Kind="BellAlert" />
          <TextBlock
            VerticalAlignment="Center"
            FontWeight="SemiBold"
            Text="{Binding BannerText}"
            TextTrimming="CharacterEllipsis" />
        </DockPanel>
      </Border>

      <!--  ===== Status bar =====  -->
      <Border
        Padding="12,4"
        Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
        BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
        BorderThickness="0,1,0,0"
        DockPanel.Dock="Bottom"
        TextElement.FontSize="12">
        <DockPanel>
          <TextBlock
            DockPanel.Dock="Right"
            Opacity="0.75"
            Text="Developed by: Umar Faruq Lilla" />
          <StackPanel Orientation="Horizontal">
            <materialDesign:PackIcon
              Width="14"
              Height="14"
              Margin="0,0,5,0"
              VerticalAlignment="Center"
              Kind="ClockOutline"
              Opacity="0.7" />
            <TextBlock VerticalAlignment="Center" Text="{Binding LastReadingText}" />
            <TextBlock
              Margin="6,0,0,0"
              VerticalAlignment="Center"
              Opacity="0.7"
              Text="{Binding SelectedSampleRate.DisplayName, StringFormat='({0})'}" />

            <Rectangle
              Width="1"
              Margin="14,2"
              Fill="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
            <materialDesign:PackIcon
              Width="14"
              Height="14"
              Margin="0,0,5,0"
              VerticalAlignment="Center">
              <materialDesign:PackIcon.Style>
                <Style TargetType="materialDesign:PackIcon">
                  <Setter Property="Kind" Value="DatabaseCheckOutline" />
                  <Setter Property="Foreground" Value="{DynamicResource OkBrush}" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDatabaseFailing}" Value="True">
                      <Setter Property="Kind" Value="DatabaseAlertOutline" />
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </materialDesign:PackIcon.Style>
            </materialDesign:PackIcon>
            <TextBlock VerticalAlignment="Center" Text="{Binding DatabaseStatusText}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsDatabaseFailing}" Value="True">
                      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                      <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>

            <Rectangle
              Width="1"
              Margin="14,2"
              Fill="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
            <materialDesign:PackIcon
              Width="14"
              Height="14"
              Margin="0,0,5,0"
              VerticalAlignment="Center"
              Kind="RemoteDesktop"
              Opacity="0.7" />
            <TextBlock
              VerticalAlignment="Center"
              Text="{Binding RemoteStatusText}"
              ToolTip="Remote control by a test software over TCP (switch in the connection bar; port in settings.xml)" />

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsSequenceRunning, Converter={StaticResource BoolToVisibilityConverter}}">
              <Rectangle
                Width="1"
                Margin="14,2"
                Fill="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
              <materialDesign:PackIcon
                Width="14"
                Height="14"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                Kind="PlaylistPlay" />
              <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource MaterialDesign.Brush.Primary}"
                Text="{Binding SequenceStatusText}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Visibility="{Binding IsTraceOn, Converter={StaticResource BoolToVisibilityConverter}}">
              <Rectangle
                Width="1"
                Margin="14,2"
                Fill="{DynamicResource MaterialDesign.Brush.Separator.Background}" />
              <materialDesign:PackIcon
                Width="14"
                Height="14"
                Margin="0,0,5,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource WarnBrush}"
                Kind="RecordRec" />
              <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource WarnBrush}"
                Text="{Binding TraceStatusText}" />
            </StackPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <!--  ===== Pages (picked with the buttons in the header) =====  -->
      <Grid>
        <Grid Visibility="{Binding IsChecked, ElementName=MonitorTab, Converter={StaticResource BoolToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!--  Connection bar  -->
          <materialDesign:Card
            Grid.Row="0"
            Margin="8,4,8,2"
            Padding="10,2"
            materialDesign:ElevationAssist.Elevation="Dp1">
            <DockPanel>
              <StackPanel
                VerticalAlignment="Center"
                DockPanel.Dock="Right"
                Orientation="Horizontal">
                <TextBlock
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  FontSize="12"
                  Opacity="0.8"
                  Text="Plot window" />
                <ComboBox
                  Width="96"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Time window"
                  DisplayMemberPath="DisplayName"
                  FontSize="12"
                  ItemsSource="{Binding GraphTimeWindows}"
                  SelectedItem="{Binding SelectedGraphTimeWindow}"
                  Style="{StaticResource MaterialDesignComboBox}"
                  ToolTip="Time span shown on the live plots while following live data. Picking one turns Follow live on again." />
                <ToggleButton
                  Margin="16,0,0,0"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Follow live"
                  IsChecked="{Binding IsFollowingLive}"
                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                  ToolTip="Keep the live plots scrolling with the newest data. Zooming or panning a plot turns this off; turn it on (or pick a plot window) to follow again." />
                <TextBlock
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  FontSize="12"
                  Opacity="0.8"
                  Text="Follow live" />
                <ToggleButton
                  Margin="16,0,0,0"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Markers"
                  IsChecked="{Binding ShowLiveMarkers}"
                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                  ToolTip="Show this session's commands (dashed), trips (solid red), alarms and connection events (dotted grey) as vertical lines on the live plots; hover one to see what it was." />
                <TextBlock
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  FontSize="12"
                  Opacity="0.8"
                  Text="Markers" />
                <Button
                  Margin="16,0,0,0"
                  AutomationProperties.Name="Toggle control panel"
                  Command="{Binding ToggleControlPanelCommand}"
                  Style="{StaticResource CompactOutlinedButton}"
                  ToolTip="Show or hide the control panel">
                  <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                      Width="16"
                      Height="16"
                      Margin="0,0,4,0"
                      VerticalAlignment="Center"
                      Kind="TuneVariant" />
                    <TextBlock VerticalAlignment="Center" Text="{Binding ControlPanelToggleText}" />
                  </StackPanel>
                </Button>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon
                  Width="18"
                  Height="18"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Kind="LanConnect"
                  Opacity="0.8" />
                <ComboBox
                  Width="160"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center"
                  materialDesign:HintAssist.Hint="IP address"
                  AutomationProperties.Name="IP address"
                  FontSize="13"
                  IsEditable="True"
                  ItemsSource="{Binding RecentIpAddresses}"
                  Style="{StaticResource MaterialDesignComboBox}"
                  Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                  ToolTip="Type an address or pick a recent one" />
                <Button
                  Margin="0,0,6,0"
                  Command="{Binding ConnectCommand}"
                  Content="CONNECT"
                  Style="{StaticResource CompactRaisedButton}" />
                <Button
                  Margin="0,0,18,0"
                  Command="{Binding DisconnectCommand}"
                  Content="DISCONNECT"
                  Style="{StaticResource CompactOutlinedButton}"
                  ToolTip="Disconnect (unlock the controls first)" />
                <TextBlock
                  Margin="0,0,6,0"
                  VerticalAlignment="Center"
                  FontSize="12"
                  Opacity="0.8"
                  Text="Sample rate" />
                <ComboBox
                  Width="80"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Sample rate"
                  DisplayMemberPath="DisplayName"
                  FontSize="12"
                  ItemsSource="{Binding SampleRates}"
                  SelectedItem="{Binding SelectedSampleRate}"
                  Style="{StaticResource MaterialDesignComboBox}"
                  ToolTip="How often the supply is read and logged to the database" />
                <ToggleButton
                  Margin="18,0,0,0"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Remote control"
                  IsChecked="{Binding IsRemoteControlOn}"
                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                  ToolTip="Remote control: a test software may connect over TCP and set, switch and read the output (docs/REMOTE_PROTOCOL.md, docs/REMOTE_PROTOCOL_CCSDS.md). Off at every start. TURN OUTPUT OFF always works here." />
                <TextBlock
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  FontSize="12"
                  Text="Remote control" />
                <ComboBox
                  Width="72"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  AutomationProperties.Name="Remote protocol"
                  DisplayMemberPath="DisplayName"
                  FontSize="12"
                  IsEnabled="{Binding CanChangeRemoteProtocol}"
                  ItemsSource="{Binding RemoteProtocols}"
                  SelectedItem="{Binding SelectedRemoteProtocol}"
                  Style="{StaticResource MaterialDesignComboBox}"
                  ToolTip="Remote protocol: JSON lines (docs/REMOTE_PROTOCOL.md) or CCSDS packets with periodic housekeeping (docs/REMOTE_PROTOCOL_CCSDS.md). Change it while Remote control is off." />
              </StackPanel>
            </DockPanel>
          </materialDesign:Card>

          <!--  Main: digital meters | live plots | control panel  -->
          <Grid
            x:Name="MainContentGrid"
            Grid.Row="1"
            Margin="6,0,6,6">
            <Grid.ColumnDefinitions>
              <ColumnDefinition
                x:Name="DigitalColumn"
                Width="5*"
                MinWidth="260" />
              <ColumnDefinition Width="6" />
              <ColumnDefinition
                x:Name="GraphColumn"
                Width="6*"
                MinWidth="300" />
              <ColumnDefinition x:Name="ControlSplitterColumn" Width="6" />
              <ColumnDefinition
                x:Name="ControlColumn"
                Width="300"
                MinWidth="260" />
            </Grid.ColumnDefinitions>

            <!--  Meters: voltage and current stacked, as large as the column allows  -->
            <materialDesign:Card
              Grid.Column="0"
              Margin="4"
              Padding="12"
              materialDesign:ElevationAssist.Elevation="Dp1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                  <ItemsControl
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Status indicators"
                    ItemsSource="{Binding StatusFlags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:StatusFlag}">
                        <Border
                          x:Name="Chip"
                          Margin="2"
                          Padding="8,2"
                          AutomationProperties.Name="{Binding Label}"
                          BorderBrush="{DynamicResource MaterialDesign.Brush.Separator.Background}"
                          CornerRadius="10"
                          BorderThickness="1"
                          ToolTip="{Binding Description}">
                          <TextBlock
                            x:Name="ChipText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Opacity="0.45"
                            Text="{Binding Label}" />
                        </Border>
                        <DataTemplate.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsActive}" Value="True" />
                              <Condition Binding="{Binding Kind}" Value="Good" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource OkBrush}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource OkBrush}" />
                            <Setter TargetName="ChipText" Property="Foreground" Value="White" />
                            <Setter TargetName="ChipText" Property="Opacity" Value="1" />
                          </MultiDataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsActive}" Value="True" />
                              <Condition Binding="{Binding Kind}" Value="Notice" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource WarnBrush}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
                            <Setter TargetName="ChipText" Property="Foreground" Value="Black" />
                            <Setter TargetName="ChipText" Property="Opacity" Value="1" />
                          </MultiDataTrigger>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding IsActive}" Value="True" />
                              <Condition Binding="{Binding Kind}" Value="Trip" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ErrorBrush}" />
                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
                            <Setter TargetName="ChipText" Property="Foreground" Value="White" />
                            <Setter TargetName="ChipText" Property="Opacity" Value="1" />
                          </MultiDataTrigger>
                        </DataTemplate.Triggers>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                <View:MeterTile
                  Grid.Row="1"
                  Margin="0,4"
                  Accent="{DynamicResource VoltageBrush}"
                  AutomationProperties.Name="Voltage"
                  FooterLeft="{Binding PowerSupplySettingStatus.SetVoltage, StringFormat='Set {0:F3} V', FallbackValue='Set --- V'}"
                  FooterRight="{Binding PowerSupplySettingStatus.SetOvpLevel, StringFormat='OVP {0:F1} V', FallbackValue='OVP --- V'}"
                  Icon="SineWave"
                  IsLive="{Binding Status.OutputEnabled}"
                  Label="VOLTAGE"
                  Unit="V"
                  Value="{Binding Status.Voltage, StringFormat='{}{0:F3}'}" />
                <View:MeterTile
                  Grid.Row="2"
                  Margin="0,4"
                  Accent="{DynamicResource CurrentBrush}"
                  AutomationProperties.Name="Current"
                  FooterLeft="{Binding PowerSupplySettingStatus.SetCurrent, StringFormat='Limit {0:F2} A', FallbackValue='Limit --- A'}"
                  FooterRight="{Binding PowerSupplySettingStatus.SetOcpLevel, StringFormat='OCP {0:F1} A', FallbackValue='OCP --- A'}"
                  Icon="CurrentDc"
                  IsLive="{Binding Status.OutputEnabled}"
                  Label="CURRENT"
                  Unit="A"
                  Value="{Binding Status.Current, StringFormat='{}{0:F3}'}" />

                <!--  Session counters  -->
                <DockPanel
                  Grid.Row="3"
                  Margin="2,6,0,0"
                  AutomationProperties.Name="Session counters"
                  TextElement.FontSize="12">
                    <Button
                      Width="26"
                      Height="26"
                      Padding="0"
                      AutomationProperties.Name="Reset counters"
                      Command="{Binding ResetCountersCommand}"
                      DockPanel.Dock="Right"
                      Style="{StaticResource MaterialDesignIconButton}"
                      ToolTip="Reset the session counters">
                      <materialDesign:PackIcon Width="16" Height="16" Kind="Restart" />
                    </Button>
                    <WrapPanel VerticalAlignment="Center">
                      <TextBlock Margin="0,0,14,0" ToolTip="Energy delivered while the output was on">
                        <Run Foreground="{DynamicResource PowerBrush}" Text="Energy" />
                        <Run FontWeight="SemiBold" Text="{Binding EnergyText, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Margin="0,0,14,0" ToolTip="Charge delivered (current × time)">
                        <Run Foreground="{DynamicResource CurrentBrush}" Text="Charge" />
                        <Run FontWeight="SemiBold" Text="{Binding ChargeText, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Margin="0,0,14,0" ToolTip="Time the output was on">
                        <Run Foreground="{DynamicResource OkBrush}" Text="ON time" />
                        <Run FontWeight="SemiBold" Text="{Binding OutputOnTimeText, Mode=OneWay}" />
                      </TextBlock>
                      <TextBlock Opacity="0.6" Text="{Binding CounterStartText}" />
                    </WrapPanel>
                </DockPanel>
              </Grid>
            </materialDesign:Card>

            <GridSplitter
              Grid.Column="1"
              Width="6"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="Transparent"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True" />

            <!--  Live plots of voltage and current  -->
            <materialDesign:Card
              Grid.Column="2"
              Margin="4"
              Padding="8"
              materialDesign:ElevationAssist.Elevation="Dp1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,2">
                  <scottPlot:WpfPlot x:Name="VoltagePlot" />
                  <Border Style="{StaticResource PlotOverlay}">
                    <ContentControl Content="{Binding VoltageYAxis}" ContentTemplate="{StaticResource YAxisOverlayTemplate}" />
                  </Border>
                </Grid>
                <Grid Grid.Row="1" Margin="0,2">
                  <scottPlot:WpfPlot x:Name="CurrentPlot" />
                  <Border Style="{StaticResource PlotOverlay}">
                    <ContentControl Content="{Binding CurrentYAxis}" ContentTemplate="{StaticResource YAxisOverlayTemplate}" />
                  </Border>
                </Grid>
              </Grid>
            </materialDesign:Card>

            <GridSplitter
              x:Name="ControlSplitter"
              Grid.Column="3"
              Width="6"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              Background="Transparent"
              ResizeBehavior="PreviousAndNext"
              ShowsPreview="True" />

            <!--  Control panel (visibility driven by code-behind with column widths). Compact so it fits a maximized 1080p window without scrolling.  -->
            <materialDesign:Card
              x:Name="ControlPanelBorder"
              Grid.Column="4"
              Margin="4"
              Padding="14,8"
              materialDesign:ElevationAssist.Elevation="Dp1"
              TextElement.FontSize="13">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <!--  Lock  -->
                  <DockPanel>
                    <ToggleButton
                      AutomationProperties.Name="Enable Configuration"
                      DockPanel.Dock="Right"
                      IsChecked="{Binding IsInConfigMode}"
                      Style="{StaticResource MaterialDesignSwitchToggleButton}"
                      ToolTip="Unlock the controls to change the supply's settings" />
                    <materialDesign:PackIcon
                      Width="20"
                      Height="20"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                      <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                          <Setter Property="Kind" Value="LockOutline" />
                          <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInConfigMode}" Value="True">
                              <Setter Property="Kind" Value="LockOpenVariantOutline" />
                              <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <TextBlock VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="Controls locked" />
                          <Setter Property="ToolTip" Value="Switch on to make changes" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInConfigMode}" Value="True">
                              <Setter Property="Text" Value="Controls unlocked" />
                              <Setter Property="ToolTip" Value="Commands go to the supply" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DockPanel>

                  <!--  Output  -->
                  <Button
                    Height="36"
                    Margin="0,6,0,0"
                    HorizontalAlignment="Stretch"
                    materialDesign:ButtonAssist.CornerRadius="8"
                    AutomationProperties.Name="Toggle output"
                    Command="{Binding ToggleOutputCommand}"
                    FontSize="15"
                    FontWeight="Bold"
                    Foreground="White">
                    <Button.Style>
                      <Style BasedOn="{StaticResource MaterialDesignRaisedButton}" TargetType="Button">
                        <Setter Property="Background" Value="#2E7D32" />
                        <Setter Property="BorderBrush" Value="#2E7D32" />
                        <Setter Property="Content" Value="TURN OUTPUT ON" />
                        <Setter Property="ToolTip" Value="Turn the output on (unlock the controls first). Asks for confirmation." />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Status.OutputEnabled}" Value="True">
                            <Setter Property="Background" Value="#C62828" />
                            <Setter Property="BorderBrush" Value="#C62828" />
                            <Setter Property="Content" Value="TURN OUTPUT OFF" />
                            <Setter Property="ToolTip" Value="Turn the output off. Always available while connected, even with the controls locked." />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>

                  <!--  Last command and its result (EER? check and read-back)  -->
                  <DockPanel
                    Margin="0,6,0,0"
                    ToolTip="{Binding LastCommandText, TargetNullValue='Last configuration command sent to the supply and its result: EER? error check and read-back (all are stored in the database)'}">
                    <DockPanel.Style>
                      <Style TargetType="DockPanel">
                        <Setter Property="Opacity" Value="0.7" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding LastCommandFailed}" Value="True">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource ErrorBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DockPanel.Style>
                    <materialDesign:PackIcon
                      Width="14"
                      Height="14"
                      Margin="0,1,5,0"
                      VerticalAlignment="Top"
                      DockPanel.Dock="Left"
                      Kind="History" />
                    <TextBlock
                      MaxHeight="30"
                      FontFamily="Consolas"
                      FontSize="11"
                      Text="{Binding LastCommandText, TargetNullValue='No command sent yet'}"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="Wrap" />
                  </DockPanel>

                  <!--  Set-points and protection: label with its allowed range | value | SET  -->
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="86" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" VerticalAlignment="Center">
                      <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource VoltageBrush}"
                        Text="Voltage" />
                      <TextBlock Style="{StaticResource RangeHint}">
                        <Run Text="{Binding MinVoltageToSet, Mode=OneWay, StringFormat='{}{0:F2}'}" /><Run Text="–" /><Run Text="{Binding MaxVoltageToSet, Mode=OneWay, StringFormat='{}{0:F2} V'}" />
                      </TextBlock>
                    </StackPanel>
                    <xceed:DoubleUpDown
                      Grid.Row="0"
                      Grid.Column="1"
                      Margin="0,2"
                      AutomationProperties.Name="Voltage set-point"
                      FormatString="F3"
                      Increment="0.1"
                      Maximum="{Binding MaxVoltageToSet}"
                      Minimum="{Binding MinVoltageToSet}"
                      Style="{StaticResource SetPointInput}"
                      Value="{Binding VoltageToSet}" />
                    <Button
                      Grid.Row="0"
                      Grid.Column="2"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="Set voltage"
                      Command="{Binding SetVoltageCommand}"
                      ToolTip="Send the voltage (1 mV resolution). Checked with EER? and read back in the same exchange.">
                      <Button.Style>
                        <Style BasedOn="{StaticResource SetButton}" TargetType="Button">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVoltageValid}" Value="False">
                              <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                      <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource CurrentBrush}"
                        Text="Current" />
                      <TextBlock Style="{StaticResource RangeHint}">
                        <Run Text="{Binding MinCurrentToSet, Mode=OneWay, StringFormat='{}{0:F2}'}" /><Run Text="–" /><Run Text="{Binding MaxCurrentToSet, Mode=OneWay, StringFormat='{}{0:F2} A'}" />
                      </TextBlock>
                    </StackPanel>
                    <xceed:DoubleUpDown
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0,2"
                      AutomationProperties.Name="Current set-point"
                      FormatString="F2"
                      Increment="0.1"
                      Maximum="{Binding MaxCurrentToSet}"
                      Minimum="{Binding MinCurrentToSet}"
                      Style="{StaticResource SetPointInput}"
                      Value="{Binding CurrentToSet}" />
                    <Button
                      Grid.Row="1"
                      Grid.Column="2"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="Set current"
                      Command="{Binding SetCurrentCommand}"
                      ToolTip="Send the current limit (10 mA resolution). Checked with EER? and read back in the same exchange.">
                      <Button.Style>
                        <Style BasedOn="{StaticResource SetButton}" TargetType="Button">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentValid}" Value="False">
                              <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>

                    <StackPanel Grid.Row="2" VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" Text="OVP" />
                      <TextBlock Style="{StaticResource RangeHint}">
                        <Run Text="{Binding MinOvpToSet, Mode=OneWay, StringFormat='{}{0:F1}'}" /><Run Text="–" /><Run Text="{Binding MaxOvpToSet, Mode=OneWay, StringFormat='{}{0:F1} V'}" />
                      </TextBlock>
                    </StackPanel>
                    <xceed:DoubleUpDown
                      Grid.Row="2"
                      Grid.Column="1"
                      Margin="0,2"
                      AutomationProperties.Name="OVP level"
                      FormatString="F1"
                      Increment="0.5"
                      Maximum="{Binding MaxOvpToSet}"
                      Minimum="{Binding MinOvpToSet}"
                      Style="{StaticResource SetPointInput}"
                      Value="{Binding OvpToSet}" />
                    <Button
                      Grid.Row="2"
                      Grid.Column="2"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="Set OVP"
                      Command="{Binding SetOvpCommand}"
                      ToolTip="Send the over-voltage trip level (0.1 V resolution). Checked with EER? and read back in the same exchange.">
                      <Button.Style>
                        <Style BasedOn="{StaticResource SetButton}" TargetType="Button">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOvpValid}" Value="False">
                              <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>

                    <StackPanel Grid.Row="3" VerticalAlignment="Center">
                      <TextBlock FontWeight="SemiBold" Text="OCP" />
                      <TextBlock Style="{StaticResource RangeHint}">
                        <Run Text="{Binding MinOcpToSet, Mode=OneWay, StringFormat='{}{0:F1}'}" /><Run Text="–" /><Run Text="{Binding MaxOcpToSet, Mode=OneWay, StringFormat='{}{0:F1} A'}" />
                      </TextBlock>
                    </StackPanel>
                    <xceed:DoubleUpDown
                      Grid.Row="3"
                      Grid.Column="1"
                      Margin="0,2"
                      AutomationProperties.Name="OCP level"
                      FormatString="F1"
                      Increment="0.5"
                      Maximum="{Binding MaxOcpToSet}"
                      Minimum="{Binding MinOcpToSet}"
                      Style="{StaticResource SetPointInput}"
                      Value="{Binding OcpToSet}" />
                    <Button
                      Grid.Row="3"
                      Grid.Column="2"
                      Margin="6,0,0,0"
                      AutomationProperties.Name="Set OCP"
                      Command="{Binding SetOcpCommand}"
                      ToolTip="Send the over-current trip level (0.1 A resolution). Checked with EER? and read back in the same exchange.">
                      <Button.Style>
                        <Style BasedOn="{StaticResource SetButton}" TargetType="Button">
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOcpValid}" Value="False">
                              <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                  </Grid>

                  <UniformGrid Margin="0,8,0,4" Columns="2">
                    <Button
                      Margin="0,0,4,0"
                      Command="{Binding SendMiscCommand}"
                      CommandParameter="TRIPRST"
                      Content="TRIP RESET"
                      Style="{StaticResource CompactOutlinedButton}"
                      ToolTip="Clear a latched OVP / OCP / sense / fault trip (TRIPRST). Remove the cause first." />
                    <Button
                      Margin="4,0,0,0"
                      Command="{Binding SendMiscCommand}"
                      CommandParameter="LOCAL"
                      Content="LOCAL"
                      Style="{StaticResource CompactOutlinedButton}"
                      ToolTip="Return the supply to front-panel control" />
                  </UniformGrid>

                    <!--  Soft limits and storage (was the Settings tab)  -->
                    <Expander
                      Margin="-14,4,-14,0"
                      Padding="14,0,14,8"
                      Background="Transparent"
                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="14,4"
                      x:Name="SoftLimitsExpander"
                      AutomationProperties.Name="Soft limits and storage"
                      Expanded="OnPanelExpanderExpanded">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="ShieldEditOutline"
                            Opacity="0.8" />
                          <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Soft limits &amp; storage" />
                        </StackPanel>
                      </Expander.Header>
                      <StackPanel>
                        <Grid ToolTip="The voltage and current set-points can only be sent inside these limits.">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>
                          <TextBlock Grid.Column="1" FontSize="11" Opacity="0.7" Text="Min" />
                          <TextBlock Grid.Column="3" FontSize="11" Opacity="0.7" Text="Max" />

                          <TextBlock
                            Grid.Row="1"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource VoltageBrush}"
                            Text="Voltage (V)" />
                          <xceed:DoubleUpDown
                            Grid.Row="1"
                            Grid.Column="1"
                            Height="28"
                            Margin="0,2"
                            AutomationProperties.Name="Minimum voltage"
                            FormatString="F2"
                            Maximum="{Binding InstrumentMaxVoltage}"
                            Minimum="0"
                            Value="{Binding LimitMinVoltage}" />
                          <xceed:DoubleUpDown
                            Grid.Row="1"
                            Grid.Column="3"
                            Height="28"
                            Margin="0,2"
                            AutomationProperties.Name="Maximum voltage"
                            FormatString="F2"
                            Maximum="{Binding InstrumentMaxVoltage}"
                            Minimum="0"
                            Value="{Binding LimitMaxVoltage}" />

                          <TextBlock
                            Grid.Row="2"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource CurrentBrush}"
                            Text="Current (A)" />
                          <xceed:DoubleUpDown
                            Grid.Row="2"
                            Grid.Column="1"
                            Height="28"
                            Margin="0,2"
                            AutomationProperties.Name="Minimum current"
                            FormatString="F2"
                            Maximum="{Binding InstrumentMaxCurrent}"
                            Minimum="0"
                            Value="{Binding LimitMinCurrent}" />
                          <xceed:DoubleUpDown
                            Grid.Row="2"
                            Grid.Column="3"
                            Height="28"
                            Margin="0,2"
                            AutomationProperties.Name="Maximum current"
                            FormatString="F2"
                            Maximum="{Binding InstrumentMaxCurrent}"
                            Minimum="0"
                            Value="{Binding LimitMaxCurrent}" />
                        </Grid>

                        <DockPanel Margin="0,8,0,0">
                          <xceed:IntegerUpDown
                            Width="80"
                            Height="28"
                            AutomationProperties.Name="Days to keep"
                            DockPanel.Dock="Right"
                            Maximum="3650"
                            Minimum="0"
                            Value="{Binding LimitRetentionDays}" />
                          <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Text="Keep logged data (days)"
                            ToolTip="0 keeps everything. Older data is deleted permanently." />
                        </DockPanel>

                        <CheckBox
                          Margin="0,8,0,0"
                          AutomationProperties.Name="Ask before turning the output ON"
                          Content="Ask before turning the output ON"
                          IsChecked="{Binding ConfirmOutputOn}"
                          ToolTip="Saved immediately" />

                        <DockPanel Margin="0,8,0,0">
                          <Button
                            Command="{Binding SaveLimitsCommand}"
                            Content="SAVE"
                            DockPanel.Dock="Right"
                            Style="{StaticResource CompactRaisedButton}" />
                          <Button
                            Margin="0,0,8,0"
                            Command="{Binding RevertLimitsCommand}"
                            Content="REVERT"
                            DockPanel.Dock="Right"
                            Style="{StaticResource CompactOutlinedButton}"
                            ToolTip="Discard unsaved changes" />
                          <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource OkBrush}"
                            Text="{Binding LimitsStatusText}" />
                        </DockPanel>
                      </StackPanel>
                    </Expander>

                    <!--  Alarms  -->
                    <Expander
                      Margin="-14,0,-14,0"
                      Padding="14,0,14,8"
                      Background="Transparent"
                      materialDesign:ExpanderAssist.HorizontalHeaderPadding="14,4"
                      x:Name="AlarmsExpander"
                      AutomationProperties.Name="Alarms"
                      Expanded="OnPanelExpanderExpanded"
                      DataContext="{Binding Alarms, Source={StaticResource Locator}}">
                      <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                          <materialDesign:PackIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="BellCogOutline"
                            Opacity="0.8" />
                          <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="Alarms" />
                        </StackPanel>
                      </Expander.Header>
                      <StackPanel>
                        <ItemsControl ItemsSource="{Binding Rules}" ToolTip="Thresholds are checked while the output is ON. Every alarm is written to the command log and shown as a red marker in History and on the live plots.">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AlarmRule}">
                              <DockPanel Height="28" Margin="0,1">
                                <TextBlock
                                  Width="14"
                                  Margin="6,0,0,0"
                                  VerticalAlignment="Center"
                                  DockPanel.Dock="Right"
                                  Opacity="0.7"
                                  Text="{Binding Unit}" />
                                <xceed:DoubleUpDown
                                  Width="86"
                                  Height="25"
                                  AutomationProperties.Name="{Binding Name}"
                                  DockPanel.Dock="Right"
                                  FormatString="F3"
                                  Increment="0.1"
                                  Minimum="0"
                                  Value="{Binding Limit}" />
                                <CheckBox
                                  VerticalAlignment="Center"
                                  AutomationProperties.Name="{Binding Name}"
                                  Content="{Binding Name}"
                                  IsChecked="{Binding IsEnabled}" />
                              </DockPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel Margin="0,4,0,0">
                          <xceed:IntegerUpDown
                            Width="70"
                            Height="26"
                            AutomationProperties.Name="Alarm delay"
                            DockPanel.Dock="Right"
                            Maximum="3600"
                            Minimum="0"
                            Value="{Binding DelaySeconds}" />
                          <TextBlock
                            VerticalAlignment="Center"
                            Text="Raise after (s)"
                            ToolTip="A threshold must be exceeded this long before the alarm is raised" />
                        </DockPanel>
                        <UniformGrid Margin="0,6,0,0" Columns="2">
                          <CheckBox
                            Margin="0,2"
                            Content="On trips"
                            IsChecked="{Binding AlarmOnTrip}"
                            ToolTip="Alarm on protection trips (OVP, OCP, sense, fault)" />
                          <CheckBox
                            Margin="0,2"
                            Content="On link loss"
                            IsChecked="{Binding AlarmOnLinkLost}"
                            ToolTip="Alarm when the link to the supply is lost" />
                          <CheckBox
                            Margin="0,2"
                            Content="Play a sound"
                            IsChecked="{Binding PlaySound}" />
                          <CheckBox
                            Margin="0,2"
                            Content="Output OFF"
                            IsChecked="{Binding TurnOutputOff}"
                            ToolTip="Software protection: turn the output OFF when a threshold alarm is raised" />
                        </UniformGrid>
                      </StackPanel>
                    </Expander>
                </StackPanel>
              </ScrollViewer>
            </materialDesign:Card>
          </Grid>
        </Grid>

        <View:SequencerView Visibility="{Binding IsChecked, ElementName=SequencerTab, Converter={StaticResource BoolToVisibilityConverter}}" />
        <View:HistoryView Visibility="{Binding IsChecked, ElementName=HistoryTab, Converter={StaticResource BoolToVisibilityConverter}}" />
        <View:DataRetrievalView Visibility="{Binding IsChecked, ElementName=DataLogsTab, Converter={StaticResource BoolToVisibilityConverter}}" />
        <View:ScpiConsoleView Visibility="{Binding IsChecked, ElementName=ConsoleTab, Converter={StaticResource BoolToVisibilityConverter}}" />
        <View:AppLogsView Visibility="{Binding IsChecked, ElementName=AppLogsTab, Converter={StaticResource BoolToVisibilityConverter}}" />
      </Grid>
    </DockPanel>
  </materialDesign:DialogHost>
</Window>
